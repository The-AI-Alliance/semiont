{
  "get": {
    "summary": "Get a resource's JSON-LD description",
    "description": "The linked-data description of the resource: its descriptor, all its annotations, and the annotations on other resources that reference it — the Archivist's answer, proxied. This is where the `Link: rel=\"describedby\"` header of every content response points.",
    "tags": [
      "Resources"
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../components/schemas/ResourceId.json"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "The resource's JSON-LD description",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "enum": [
                "no-cache"
              ]
            },
            "description": "Annotations and references change, so a cache must revalidate."
          }
        },
        "content": {
          "application/ld+json": {
            "schema": {
              "$ref": "../components/schemas/GetResourceResponse.json"
            }
          }
        }
      },
      "401": {
        "$ref": "../components/responses/Unauthorized.json"
      },
      "404": {
        "description": "The knowledge base has no such resource.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      },
      "500": {
        "$ref": "../components/responses/InternalError.json"
      },
      "503": {
        "$ref": "../components/responses/ServiceUnavailable.json"
      }
    }
  }
}
