{
  "post": {
    "operationId": "createMediaToken",
    "summary": "Generate Media Token",
    "description": "A short-lived, resource-scoped media token (see the `mediaToken` scheme) for a `?token=` query parameter on `GET /api/resources/{id}`, where `<img>`, PDF.js and download links cannot send a header. Requires a bearer token.",
    "tags": [
      "Authentication"
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../components/schemas/MediaTokenRequest.json"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Media token generated",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/MediaTokenResponse.json"
            }
          }
        }
      },
      "400": {
        "description": "The body is not JSON, or does not match MediaTokenRequest.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      },
      "401": {
        "$ref": "../components/responses/Unauthorized.json"
      },
      "413": {
        "$ref": "../components/responses/PayloadTooLarge.json"
      },
      "500": {
        "$ref": "../components/responses/InternalError.json"
      }
    },
    "x-semiont-limits": {
      "maxBodyBytes": 1048576
    }
  }
}
