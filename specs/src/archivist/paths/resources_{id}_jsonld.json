{
  "get": {
    "summary": "A resource's linked-data description",
    "description": "The descriptor, its annotations, and the annotations elsewhere that reference it — what the gateway serves at its own `GET /resources/{id}/jsonld`.",
    "security": [
      {
        "serviceAccount": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The resource, percent-encoded.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    ],
    "responses": {
      "200": {
        "description": "The description.",
        "content": {
          "application/ld+json": {
            "schema": {
              "$ref": "../../components/schemas/GetResourceResponse.json"
            }
          }
        }
      },
      "401": {
        "$ref": "../responses/Unauthorized.json"
      },
      "404": {
        "description": "The record holds no such resource.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/ErrorResponse.json"
            }
          }
        }
      },
      "500": {
        "$ref": "../../components/responses/InternalError.json"
      }
    }
  }
}
