{
  "type": "object",
  "description": "A job a worker has claimed and not yet concluded.",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "running"
      ]
    },
    "metadata": {
      "$ref": "./JobMetadata.json"
    },
    "params": {
      "$ref": "./JobParams.json"
    },
    "startedAt": {
      "type": "string",
      "description": "When the claim that holds it was made, as an ISO 8601 timestamp."
    },
    "progress": {
      "description": "The last progress the worker reported, or an empty object before its first report.",
      "anyOf": [
        {
          "$ref": "./JobProgress.json"
        },
        {
          "type": "object",
          "maxProperties": 0
        }
      ]
    }
  },
  "required": [
    "status",
    "metadata",
    "params",
    "startedAt",
    "progress"
  ],
  "additionalProperties": false
}
