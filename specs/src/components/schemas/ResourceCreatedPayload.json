{
  "type": "object",
  "description": "Payload for yield:created domain event",
  "properties": {
    "name": {
      "type": "string"
    },
    "format": {
      "$ref": "ContentFormat.json"
    },
    "contentChecksum": {
      "type": "string",
      "description": "SHA-256 of content"
    },
    "contentByteSize": {
      "type": "integer"
    },
    "entityTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storageUri": {
      "type": "string",
      "description": "The creating instruction's URI, recorded on the event. Append-only, so this value never changes \u2014 the LOCATION the projection serves is maintained across moves and lives on the resource's primary Representation, relocated by yield:moved. Optional: a resource may have no bytes. Working-tree URI, only file:// is supported (e.g. file://docs/overview.md)."
    },
    "language": {
      "type": "string"
    },
    "isDraft": {
      "type": "boolean"
    },
    "generatedFrom": {
      "type": "object",
      "properties": {
        "resourceId": {
          "type": "string"
        },
        "annotationId": {
          "type": "string"
        }
      },
      "required": [
        "resourceId",
        "annotationId"
      ]
    },
    "generationPrompt": {
      "type": "string"
    },
    "generator": {
      "oneOf": [
        {
          "$ref": "Agent.json"
        },
        {
          "type": "array",
          "items": {
            "$ref": "Agent.json"
          }
        }
      ]
    }
  },
  "required": [
    "name",
    "format",
    "contentChecksum"
  ]
}
