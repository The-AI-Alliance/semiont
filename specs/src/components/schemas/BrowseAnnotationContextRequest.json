{
  "type": "object",
  "description": "Request to get contextual text around an annotation",
  "properties": {
    "annotationId": {
      "$ref": "./AnnotationId.json"
    },
    "resourceId": {
      "$ref": "./ResourceId.json"
    },
    "contextBefore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    },
    "contextAfter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    }
  },
  "required": [
    "annotationId",
    "resourceId"
  ]
}
