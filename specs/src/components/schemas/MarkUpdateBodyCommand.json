{
  "type": "object",
  "description": "Bus command to update an annotation's body with patch operations.",
  "properties": {
    "_userId": {
      "type": "string",
      "description": "Authenticated user's DID, injected by the /bus/emit gateway. Clients do not set this."
    },
    "annotationId": {
      "type": "string"
    },
    "resourceId": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "./BodyOperationAdd.json"
          },
          {
            "$ref": "./BodyOperationRemove.json"
          },
          {
            "$ref": "./BodyOperationReplace.json"
          }
        ]
      }
    }
  },
  "required": [
    "annotationId",
    "resourceId",
    "operations"
  ]
}
