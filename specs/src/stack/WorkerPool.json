{
  "title": "WorkerPool",
  "type": "object",
  "description": "The worker a machine runs knowledge bases' jobs with: its image, its memory and its log level. They are the machine's, not any knowledge base's, so its document is kept in the launcher's state home, in `stack/workers.yaml`, not in a knowledge base's repository. A knowledge base's jobs are done when its Inference document gives a job an engine. A worker needs only the Gateway, and an issuer's token with the worker's role.",
  "properties": {
    "apiVersion": {
      "$ref": "./ApiVersion.json"
    },
    "kind": {
      "type": "string",
      "const": "WorkerPool"
    },
    "metadata": {
      "$ref": "./Metadata.json"
    },
    "spec": {
      "type": "object",
      "description": "How the worker runs.",
      "properties": {
        "logLevel": {
          "$ref": "../components/schemas/LogLevel.json"
        },
        "worker": {
          "type": "object",
          "description": "The Worker.",
          "properties": {
            "image": {
              "$ref": "./Image.json"
            },
            "resources": {
              "$ref": "./Resources.json"
            }
          },
          "required": [
            "image",
            "resources"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "logLevel",
        "worker"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
