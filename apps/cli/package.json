{
  "name": "@semiont/cli",
  "version": "0.5.22",
  "description": "Deprecated — install the Semiont launcher instead (brew install the-ai-alliance/semiont/semiont)",
  "type": "module",
  "bin": {
    "semiont": "./dist/cli.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-AI-Alliance/semiont.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "semiont",
    "deprecated"
  ],
  "author": "Semiont Team",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node build.mjs && npm run typecheck",
    "build:only": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.27.2"
  }
}
