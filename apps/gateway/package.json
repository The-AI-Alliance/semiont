{
  "name": "semiont-gateway",
  "version": "0.6.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsup && node --watch --conditions=development dist/index.js",
    "build": "npm run build:app",
    "build:app": "npm run typecheck && tsup",
    "build:clean": "npm run clean && npm run typecheck && tsup",
    "build:fast": "npm run typecheck && tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --testNamePattern=\"^(?!.*integration).*\"",
    "test:integration": "vitest run --config=vitest.integration.config.mjs",
    "test:api": "vitest run src/__tests__/middleware/auth.test.ts",
    "test:security": "vitest run --reporter=verbose --testNamePattern=security"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@semiont/core": "*",
    "@semiont/jobs": "*",
    "@semiont/make-meaning": "*",
    "@semiont/observability": "*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "nats": "^2.29.3",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@semiont/content": "*",
    "@semiont/event-sourcing": "*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "fast-check": "^4.10.0",
    "msw": "^2.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
