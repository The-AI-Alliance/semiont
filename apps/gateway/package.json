{
  "name": "semiont-gateway",
  "version": "0.6.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsup && node --watch --conditions=development dist/index.js",
    "build": "npm run build:app",
    "build:app": "npm run typecheck && tsup",
    "build:clean": "npm run clean && npm run typecheck && tsup",
    "build:fast": "npm run typecheck && tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@semiont/core": "*",
    "@semiont/observability": "*",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "nats": "^2.29.3",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.0",
    "rxjs": "^7.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
