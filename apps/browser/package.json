{
  "name": "semiont-browser",
  "version": "0.6.12",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "scripts": {
    "audit:compliance": "./scripts/generate-compliance-report.sh",
    "audit:compliance:tests": "./scripts/generate-test-compliance-report.sh",
    "predev": "node scripts/merge-translations.js",
    "dev": "node scripts/copy-favicons.js && node scripts/copy-pdf-wasm.js && vite --host",
    "prebuild": "node scripts/merge-translations.js",
    "build": "node scripts/copy-favicons.js && node scripts/copy-pdf-wasm.js && npm run typecheck && vite build",
    "build:quick": "vite build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "prestart": "node scripts/merge-translations.js",
    "start": "vite preview --host",
    "pretest": "node scripts/merge-translations.js",
    "test": "vitest run --reporter=default --reporter=json --outputFile=test-results.json",
    "test:watch": "vitest",
    "pretest:coverage": "node scripts/merge-translations.js",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --reporter=default --reporter=json --outputFile=test-results.json --testNamePattern=\"^(?!.*integration).*\"",
    "test:integration": "vitest run --reporter=default --reporter=json --outputFile=test-results.json --testNamePattern=\"integration\"",
    "pretest:security": "node scripts/merge-translations.js",
    "test:security": "vitest run --reporter=verbose 'src/app/[locale]/__tests__/protected-layout-session-gates.test.tsx' 'src/app/[locale]/__tests__/layout.test.tsx' src/lib/__tests__/validation.test.ts",
    "test:a11y": "vitest run -t \"Accessibility\"",
    "test:a11y:watch": "vitest -t \"Accessibility\"",
    "test:typecheck": "vitest typecheck",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:test"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@semiont/http-transport": "*",
    "@semiont/react-ui": "*",
    "@semiont/sdk": "*",
    "i18next": "^26.4.2",
    "i18next-http-backend": "^4.0.2",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
