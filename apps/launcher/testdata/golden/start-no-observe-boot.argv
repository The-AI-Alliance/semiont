container image pull ghcr.io/the-ai-alliance/semiont-librarian:latest
container run -d --name semiont-otel-collector --memory 1G -p 4318:4318 -p 24110:24110 --volume <config-stage>/collector.yaml:/etc/otelcol/config.yaml:ro otel/opentelemetry-collector:0.137.0
container run -d --name semiont-postgres --memory 1G -p 5432:5432 -v <home>/.local/share/semiont/roots/example.github.io-test-kb/postgres:/var/lib/postgresql/data -e PGDATA=/var/lib/postgresql/data/pgdata -e POSTGRES_PASSWORD=localpass -e POSTGRES_DB=semiont postgres:15.18-alpine
container run --rm busybox:1.38.0 nc -z -w 2 192.168.64.1 5432
container run -d --name semiont-gateway --publish 4000:4000 --memory 2G --volume <config-stage>/gateway.toml:/home/semiont/.semiontconfig:ro -v <home>/.local/share/semiont/roots/example.github.io-test-kb/state:/semiont-state --env OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.64.1:4318 --env POSTGRES_HOST=192.168.64.1 --env NEO4J_HOST=192.168.64.1 --env QDRANT_HOST=192.168.64.1 --env OLLAMA_HOST=192.168.64.1 --env XDG_STATE_HOME=/semiont-state --env SEMIONT_WORKER_SECRET=test-worker-secret --env JWT_SECRET=test-jwt-secret-0123456789abcdef ghcr.io/the-ai-alliance/semiont-gateway:latest
container run --rm busybox:1.38.0 sh -c wget -q -O- http://192.168.64.1:4000/api/health
container run -d --name semiont-neo4j --memory 2G -p 7474:7474 -p 7687:7687 -v <home>/.local/share/semiont/roots/example.github.io-test-kb/neo4j/data:/data -v <home>/.local/share/semiont/roots/example.github.io-test-kb/neo4j/logs:/logs -e NEO4J_AUTH=neo4j/localpass -e NEO4J_ACCEPT_LICENSE_AGREEMENT=yes neo4j:5.26.28-community
container run -d --name semiont-qdrant --memory 2G -p 6333:6333 -v <home>/.local/share/semiont/roots/example.github.io-test-kb/qdrant:/qdrant/storage qdrant/qdrant:v1.18.3
lsof -nP -iTCP:11434 -sTCP:LISTEN
lsof -nP -iTCP:11434 -sTCP:LISTEN
container run -d --name semiont-ollama --memory 24G -p 11434:11434 -v semiont-ollama-models:/root/.ollama ollama/ollama
container run -d --name semiont-archivist --memory 2G --publish 24103:24103 --volume <kb-root>:/kb --volume <config-stage>/archivist.toml:/home/semiont/.semiontconfig:ro -v <home>/.local/share/semiont/roots/example.github.io-test-kb/anchored-text:/anchored-text -v <home>/.local/share/semiont/roots/example.github.io-test-kb/state:/semiont-state --env OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.64.1:4318 --env GATEWAY_HOST=192.168.64.1 --env BACKEND_HOST=192.168.64.1 --env OLLAMA_HOST=192.168.64.1 --env NEO4J_HOST=192.168.64.1 --env QDRANT_HOST=192.168.64.1 --env POSTGRES_HOST=192.168.64.1 --env XDG_STATE_HOME=/semiont-state --env SEMIONT_WORKER_SECRET=test-worker-secret ghcr.io/the-ai-alliance/semiont-archivist:latest
container run -d --name semiont-librarian --memory 2G --publish 24104:24104 --volume <config-stage>/librarian.toml:/home/semiont/.semiontconfig:ro -v <home>/.local/share/semiont/roots/example.github.io-test-kb/state:/semiont-state --env OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.64.1:4318 --env GATEWAY_HOST=192.168.64.1 --env BACKEND_HOST=192.168.64.1 --env OLLAMA_HOST=192.168.64.1 --env NEO4J_HOST=192.168.64.1 --env QDRANT_HOST=192.168.64.1 --env POSTGRES_HOST=192.168.64.1 --env XDG_STATE_HOME=/semiont-state --env SEMIONT_WORKER_SECRET=test-worker-secret ghcr.io/the-ai-alliance/semiont-librarian:latest
container run -d --name semiont-worker --memory 2G --publish 24100:24100 --volume <config-stage>/worker.toml:/home/semiont/.semiontconfig:ro --env OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.64.1:4318 --env GATEWAY_HOST=192.168.64.1 --env BACKEND_HOST=192.168.64.1 --env OLLAMA_HOST=192.168.64.1 --env NEO4J_HOST=192.168.64.1 --env QDRANT_HOST=192.168.64.1 --env POSTGRES_HOST=192.168.64.1 --env SEMIONT_WORKER_SECRET=test-worker-secret ghcr.io/the-ai-alliance/semiont-worker:latest
container run -d --name semiont-smelter --memory 2G --publish 24101:24101 --volume <config-stage>/smelter.toml:/home/semiont/.semiontconfig:ro --env OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.64.1:4318 --env GATEWAY_HOST=192.168.64.1 --env BACKEND_HOST=192.168.64.1 --env OLLAMA_HOST=192.168.64.1 --env NEO4J_HOST=192.168.64.1 --env QDRANT_HOST=192.168.64.1 --env POSTGRES_HOST=192.168.64.1 --env SEMIONT_WORKER_SECRET=test-worker-secret -v <home>/.local/share/semiont/roots/example.github.io-test-kb/anchored-text:/anchored-text ghcr.io/the-ai-alliance/semiont-smelter:latest
container run -d --name semiont-weaver --memory 2G --publish 24102:24102 --volume <config-stage>/weaver.toml:/home/semiont/.semiontconfig:ro --env OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.64.1:4318 --env GATEWAY_HOST=192.168.64.1 --env BACKEND_HOST=192.168.64.1 --env OLLAMA_HOST=192.168.64.1 --env NEO4J_HOST=192.168.64.1 --env QDRANT_HOST=192.168.64.1 --env POSTGRES_HOST=192.168.64.1 --env SEMIONT_WORKER_SECRET=test-worker-secret ghcr.io/the-ai-alliance/semiont-weaver:latest
