# Stage 1: install (npm runs here, then is discarded).
#
# The Librarian is a separate image from the shared @semiont/make-meaning
# package, like smelter/weaver/archivist — separate because their dependency
# footprints differ. This is the heaviest of the set: the Matcher dials the
# graph (neo4j-driver, a lazy peer of @semiont/graph, bundled explicitly) AND
# Qdrant (the qdrant client @semiont/make-meaning already carries) AND an
# embedding provider AND an inference client. It is NOT the git writer — no
# git in this image (that is the Archivist, GATEWAY.md D4b).
#
# Base is node:24-alpine (not node:26): node 26's built-in undici breaks the
# qdrant client's undici@6, which @semiont/make-meaning can load transitively at
# connect time. Keep in sync with the backend image.
FROM node:24-alpine AS installer
ARG NPM_REGISTRY=https://registry.npmjs.org
ARG SEMIONT_VERSION=latest
RUN npm config set registry $NPM_REGISTRY && \
    npm install -g @semiont/make-meaning@${SEMIONT_VERSION} neo4j-driver && \
    npm cache clean --force

# Stage 2: minimal runtime — node only, no npm. The runtime entrypoint is
# `node librarian-main.js`, so npm is build-only baggage. Removing it also drops
# the picomatch / glob / etc. CVE surface that ships inside npm's bundled
# node_modules.
FROM node:24-alpine
# Patch base-image OS packages so alpine security fixes apply even when the
# node:24-alpine snapshot hasn't been rebuilt against them yet.
RUN apk upgrade --no-cache

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 semiont

# The global @semiont/make-meaning + neo4j-driver (with hoisted deps) and bins.
COPY --from=installer /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=installer /usr/local/bin /usr/local/bin

# Strip npm/npx (re-introduced by the COPY above) plus the TypeScript compiler.
# `typescript` + its native `@typescript/*` Go binaries are pulled transitively
# via the qdrant client's dep chain but never loaded at runtime — build-only
# baggage, and the native `tsc` carries a Go-stdlib CVE (CVE-2026-39822).
RUN rm -rf /usr/local/lib/node_modules/npm \
           /usr/local/bin/npm \
           /usr/local/bin/npx && \
    find /usr/local/lib/node_modules \
      -type d \( -name typescript -o -name '@typescript' \) -prune -exec rm -rf {} +

COPY LICENSE /home/semiont/LICENSE
COPY packages/make-meaning/NOTICE.librarian /home/semiont/NOTICE

WORKDIR /home/semiont
USER semiont

ENV NODE_ENV=production
# No SEMIONT_ROOT and no SEMIONT_ANCHORED_TEXT_DIR — this image mounts no
# piece of the KB tree (SINGLE-KB-MOUNT P1). The Librarian locates the views
# it reads from the staged `[kb] name` under the shared state mount, and
# everything else reaches it over the wire.
EXPOSE 9094

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:9094/health', r => process.exit(r.statusCode < 400 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["node", "/usr/local/lib/node_modules/@semiont/make-meaning/dist/librarian-main.js"]
