        },
        "command": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "dataDir": {
          "type": "string",
