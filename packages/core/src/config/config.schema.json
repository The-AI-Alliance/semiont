                  "url": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "healthCheck": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "redisUrl": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
