      ]
    },
    "ResourceRequirements": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        },
        "gpu": {
          "type": "integer"
        },
        "gpus": {
          "type": "integer"
        },
        "replicas": {
          "type": "integer"
        },
        "ephemeralStorage": {
          "type": "string"
        },
        "memoryReservation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SecurityRequirements": {
      "type": "object",
      "properties": {
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "capabilities": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "properties": {
                "add": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "drop": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "privileged": {
          "type": "boolean"
        },
        "allowPrivilegeEscalation": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "BuildRequirements": {
      "type": "object",
      "properties": {
        "dockerfile": {
          "type": "string"
        },
        "buildContext": {
          "type": "string"
        },
        "buildArgs": {
          "type": "object",
          "additionalProperties": {
