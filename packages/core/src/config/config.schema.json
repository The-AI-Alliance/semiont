        "timeout": {
          "type": "integer"
        },
        "wait": {
          "type": "integer"
        },
        "logsEndpoint": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "resources": {
          "$ref": "#/definitions/ResourceRequirements"
        },
        "security": {
          "$ref": "#/definitions/SecurityRequirements"
        },
        "build": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/definitions/BuildRequirements"
            }
          ]
