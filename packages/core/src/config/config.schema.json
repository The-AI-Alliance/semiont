          "type": "string"
        },
        "buildContext": {
          "type": "string"
        },
        "buildArgs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "buildTarget": {
          "type": "string"
        },
        "prebuilt": {
          "type": "boolean"
        },
        "noCache": {
          "type": "boolean"
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
