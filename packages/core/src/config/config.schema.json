    "ServicesConfig": {
      "type": "object",
      "properties": {
        "gateway": {
          "$ref": "#/definitions/GatewayServiceConfig"
        },
        "database": {
          "$ref": "#/definitions/DatabaseServiceConfig"
        },
        "graph": {
          "$ref": "#/definitions/GraphServiceConfig"
