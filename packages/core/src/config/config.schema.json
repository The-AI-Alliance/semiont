        "command": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "publicURL": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        },
        "databaseUrl": {
          "type": "string"
        },
        "projectRoot": {
          "type": "string"
        },
        "timeout": {
          "type": "integer"
        },
        "wait": {
          "type": "integer"
        },
        "logsEndpoint": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "resources": {
          "$ref": "#/definitions/ResourceRequirements"
        },
        "security": {
          "$ref": "#/definitions/SecurityRequirements"
        },
        "build": {
          "oneOf": [
            {
              "type": "boolean"
            },
