          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "buildTarget": {
          "type": "string"
        },
        "prebuilt": {
          "type": "boolean"
        },
        "noCache": {
          "type": "boolean"
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalDependencies": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "healthCheck": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "platform",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "neo4j"
              }
            }
          },
          "then": {
            "required": [
              "uri",
              "username",
              "password",
              "database"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
