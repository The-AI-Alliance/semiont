{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semiont.org/schemas/config.json",
  "definitions": {
    "PlatformType": {
      "type": "string",
      "enum": [
        "posix",
        "container",
        "aws",
        "external"
      ]
    },
    "ServicePlatformConfig": {
      "type": "object",
      "properties": {
