{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semiont.org/schemas/config.json",
  "definitions": {
    "PlatformType": {
      "type": "string",
      "enum": [
        "posix",
        "container",
        "aws",
        "external"
      ]
    },
    "ServicePlatformConfig": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/definitions/PlatformType"
        }
      },
      "required": [
        "type"
      ]
    },
    "GatewayServiceConfig": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/definitions/ServicePlatformConfig"
        },
        "port": {
          "type": "integer"
        },
        "publicURL": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "platform",
        "port",
        "publicURL"
      ],
      "additionalProperties": false
    },
    "VectorsServiceConfig": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/definitions/ServicePlatformConfig"
        },
        "type": {
          "type": "string",
          "enum": [
            "qdrant",
            "memory"
          ]
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "default": 6333
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "EmbeddingServiceConfig": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/definitions/ServicePlatformConfig"
        },
        "type": {
          "type": "string",
          "enum": [
            "voyage",
            "ollama"
          ]
        },
        "model": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        },
        "baseURL": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "chunking": {
          "type": "object",
          "properties": {
            "chunkSize": {
              "type": "integer",
              "default": 512
            },
            "overlap": {
              "type": "integer",
              "default": 64
            }
          }
        }
      },
      "required": [
        "type",
        "model"
      ],
      "additionalProperties": false
    },
    "DatabaseServiceConfig": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/definitions/ServicePlatformConfig"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "platform",
        "type",
        "host",
        "port"
      ],
      "additionalProperties": false
    },
    "GraphDatabaseType": {
      "type": "string",
      "enum": [
        "neo4j",
        "janusgraph",
        "neptune",
        "memory"
      ]
    },
    "GraphServiceConfig": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/definitions/ServicePlatformConfig"
        },
        "type": {
          "$ref": "#/definitions/GraphDatabaseType"
        },
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "storage": {
          "type": "string"
        },
        "index": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "platform",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "neo4j"
              }
            }
          },
          "then": {
            "required": [
              "uri",
              "username",
              "password",
              "database"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "OllamaProviderConfig": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/definitions/ServicePlatformConfig"
        },
        "baseURL": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "image": {
          "type": "string"
        }
      },
      "required": [
        "platform"
      ],
      "additionalProperties": false
    },
    "AnthropicProviderConfig": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "external"
          ]
        },
        "endpoint": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        }
      },
      "required": [
        "platform",
        "endpoint",
        "apiKey"
      ],
      "additionalProperties": false
    },
    "InferenceProvidersConfig": {
      "type": "object",
      "properties": {
        "ollama": {
          "$ref": "#/definitions/OllamaProviderConfig"
        },
        "anthropic": {
          "$ref": "#/definitions/AnthropicProviderConfig"
        }
      },
      "additionalProperties": true
    },
    "ServicesConfig": {
      "type": "object",
      "properties": {
        "gateway": {
          "$ref": "#/definitions/GatewayServiceConfig"
        },
        "database": {
          "$ref": "#/definitions/DatabaseServiceConfig"
        },
        "graph": {
          "$ref": "#/definitions/GraphServiceConfig"
        },
        "vectors": {
          "$ref": "#/definitions/VectorsServiceConfig"
        },
        "embedding": {
          "$ref": "#/definitions/EmbeddingServiceConfig"
        },
        "archivist": {
          "$ref": "#/definitions/ArchivistServiceConfig"
        },
        "identity": {
          "$ref": "#/definitions/IdentityServiceConfig"
        }
      },
      "required": [
        "vectors",
        "embedding",
        "identity"
      ],
      "additionalProperties": true
    },
    "EnvironmentConfig": {
      "type": "object",
      "properties": {
        "_metadata": {
          "type": "object",
          "properties": {
            "environment": {
              "type": "string"
            },
            "projectRoot": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "environment",
            "projectRoot"
          ]
        },
        "name": {
          "type": "string",
          "description": "Environment name"
        },
        "kb": {
          "type": "object",
          "description": "The KB's committed identity, staged by the launcher (SINGLE-KB-MOUNT D4). Top-level in the staged file, out of any environment section's reach; never overridable.",
          "properties": {
            "name": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "platform": {
          "type": "object",
          "properties": {
            "default": {
              "$ref": "#/definitions/PlatformType"
            }
          }
        },
        "services": {
          "$ref": "#/definitions/ServicesConfig"
        },
        "inference": {
          "$ref": "#/definitions/InferenceProvidersConfig"
        },
        "workers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "inference": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "actors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "inference": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "required": [
        "services"
      ],
      "additionalProperties": true
    },
    "ArchivistServiceConfig": {
      "type": "object",
      "description": "The Archivist service \u2014 the out-of-process keeper of the record (EXTRACT-ARCHIVIST). Internal-only: the gateway dials host:port for the D1 sequence-ranged event read path; nothing public.",
      "properties": {
        "platform": {
          "$ref": "#/definitions/ServicePlatformConfig"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "image": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "IdentityServiceConfig": {
      "type": "object",
      "description": "The OIDC issuer the gateway trusts for human tokens (EXTERNAL-IDENTITY D5). Selection is stated here, never inferred: 'keycloak' is the launcher-run Keycloak; 'oidc' is an external issuer the launcher never launches. 'issuer' is the issuer URL exactly as it appears in a token's iss claim (its host may reference environment via ${VAR} placeholders \u2014 the CONFIG names the variable; code never invents one). There is no 'audience' key: the audience is the knowledge base's own resource identifier, derived from its committed did:web domain, so it cannot be configured into disagreement with the identity the KB publishes. 'subjectClaim' is the issuer claim a person's DID is built from — did:web:<site domain>:users:<that claim's value> — declared per deployment, never defaulted by code: \"sub\" names people by the issuer's stable identifier, \"email\" by their address. 'type', 'issuer' and 'subjectClaim' are required for both types. 'accessTokenLifespan' (seconds) overrides the launcher's default revocation window and applies only to type='keycloak', since only a realm the launcher writes has a lifespan Semiont sets; a realm imports on FIRST BOOT only, so changing it does not reach a deployment that already exists. 'image' overrides the catalog's Keycloak image. Both extra keys are read by the launcher alone \u2014 the gateway never sees them.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "keycloak",
            "oidc"
          ]
        },
        "issuer": {
          "type": "string"
        },
        "subjectClaim": {
          "type": "string",
          "minLength": 1,
          "description": "The issuer claim a person's DID is built from: did:web:<site domain>:users:<this claim's value>. Declared, never defaulted."
        },
        "accessTokenLifespan": {
          "type": "integer",
          "minimum": 1,
          "description": "Seconds a token the realm mints stays valid, and so the window in which a disabled account can still act. type='keycloak' only. Default 300."
        },
        "image": {
          "type": "string",
          "description": "Override the Keycloak image the launcher runs. type='keycloak' only."
        }
      },
      "required": [
        "type",
        "issuer",
        "subjectClaim"
      ],
      "additionalProperties": false
    }
  }
}
