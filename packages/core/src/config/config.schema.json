    "SiteConfig": {
      "type": "object",
      "properties": {
        "siteName": {
          "type": "string",
          "minLength": 1,
          "description": "Display name for the site"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "description": "Primary domain for the site"
        },
        "adminEmail": {
          "type": "string",
          "format": "email",
          "description": "Administrator email address"
        },
        "supportEmail": {
          "type": "string",
          "format": "email",
          "description": "Support email address (optional)"
        }
      },
      "additionalProperties": false
    },
    "AppConfig": {
      "type": "object",
      "properties": {
        "features": {
          "type": "object",
          "properties": {
            "enableAnalytics": {
              "type": "boolean"
            },
            "enableMaintenanceMode": {
              "type": "boolean"
            },
            "enableDebugLogging": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "security": {
          "type": "object",
          "properties": {
            "sessionTimeout": {
              "type": "integer",
              "minimum": 60,
              "description": "Session timeout in seconds"
            },
            "maxLoginAttempts": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum failed login attempts before lockout"
            },
            "corsAllowedOrigins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enableLocalAuth": {
              "type": "boolean",
              "description": "Enable local username/password authentication"
            },
            "jwtSecret": {
              "type": "string",
              "minLength": 32,
              "description": "JWT signing secret (base64 encoded, 32+ bytes)"
            }
          },
          "additionalProperties": false
        },
        "performance": {
          "type": "object",
          "properties": {
            "enableCaching": {
              "type": "boolean"
            },
            "cacheTimeout": {
              "type": "integer",
              "minimum": 0,
              "description": "Cache timeout in seconds"
            },
            "maxRequestSize": {
              "type": "string",
              "pattern": "^[0-9]+(kb|mb|gb)$",
              "description": "Maximum request size (e.g., '10mb')"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "EnvironmentConfig": {
      "type": "object",
      "properties": {
        "_comment": {
          "type": "string",
          "description": "Optional comment for documentation"
        },
        "_metadata": {
          "type": "object",
          "properties": {
            "environment": {
              "type": "string"
            },
            "projectRoot": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "environment",
            "projectRoot"
          ]
        },
        "name": {
          "type": "string",
          "description": "Environment name"
        },
        "kb": {
          "type": "object",
          "description": "The KB's committed identity, staged by the launcher (SINGLE-KB-MOUNT D4). Top-level in the staged file, out of any environment section's reach; never overridable.",
          "properties": {
            "name": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "platform": {
          "type": "object",
          "properties": {
            "default": {
              "$ref": "#/definitions/PlatformType"
            }
          }
        },
        "services": {
          "$ref": "#/definitions/ServicesConfig"
        },
        "inference": {
          "$ref": "#/definitions/InferenceProvidersConfig"
        },
        "workers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "inference": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "actors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "inference": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "site": {
          "$ref": "#/definitions/SiteConfig"
        },
        "app": {
          "$ref": "#/definitions/AppConfig"
        },
        "env": {
          "type": "object",
          "properties": {
            "NODE_ENV": {
              "type": "string",
              "enum": [
                "development",
                "production",
                "test"
              ]
            }
          },
          "additionalProperties": true
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "http",
            "debug"
          ],
          "description": "Logging verbosity level"
        },
        "deployment": {
          "type": "object",
          "properties": {
            "imageTagStrategy": {
              "type": "string",
              "enum": [
                "mutable",
                "immutable",
                "git-hash"
              ]
            }
          }
        }
      },
      "required": [
        "services"
      ],
      "additionalProperties": true
    },
    "SemiontConfig": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Config file version (semver)"
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Project name"
        },
        "site": {
          "$ref": "#/definitions/SiteConfig"
        },
        "app": {
          "$ref": "#/definitions/AppConfig"
        },
        "services": {
          "$ref": "#/definitions/ServicesConfig"
        }
      },
      "required": [
        "version",
        "project",
        "site"
      ],
      "additionalProperties": false
    },
    "JobsServiceConfig": {
      "type": "object",
      "description": "The job queue driver (JOB-QUEUE-DRIVER). Selection is stated here, never inferred: 'fs' is the filesystem queue inside the gateway; 'jetstream' is NATS JetStream \u2014 KV operational state plus stream-held leases. Absent section means 'fs'. 'servers' is the NATS address and may reference environment via ${VAR} placeholders \u2014 the CONFIG names the variable; code never invents one.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "fs",
            "jetstream"
          ]
        },
        "servers": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "ArchivistServiceConfig": {
      "type": "object",
      "description": "The Archivist service \u2014 the out-of-process keeper of the record (EXTRACT-ARCHIVIST). Internal-only: the gateway dials host:port for the D1 sequence-ranged event read path; nothing public.",
      "properties": {
        "platform": {
          "$ref": "#/definitions/ServicePlatformConfig"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "image": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "SignalServiceConfig": {
      "type": "object",
      "description": "The Signal Plane driver (SIGNAL-PLANE P2). Selection is stated here, never inferred: 'in-process' is the RxJS relay inside the gateway (the permanent local default \u2014 D7); 'nats' selects core NATS subjects on the shared messaging daemon (never JetStream \u2014 D3). Absent section means 'in-process'. 'servers' is required for 'nats' and may reference environment via ${VAR} placeholders \u2014 the CONFIG names the variable; code never invents one.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "in-process",
            "nats"
          ]
        },
        "servers": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "IdentityServiceConfig": {
      "type": "object",
      "description": "The OIDC issuer the gateway trusts for human tokens (EXTERNAL-IDENTITY D5). Selection is stated here, never inferred: 'keycloak' is the launcher-run Keycloak; 'oidc' is an external issuer the launcher never launches. 'issuer' is the issuer URL exactly as it appears in a token's iss claim (its host may reference environment via ${VAR} placeholders — the CONFIG names the variable; code never invents one); 'audience' is the client id the gateway expects in a token's aud claim. All three are required for both types.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "keycloak",
            "oidc"
          ]
        },
        "issuer": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "issuer",
        "audience"
      ],
      "additionalProperties": false
    }
  }
}
