(test
 (name transport)
 (modules transport)
 (libraries eio_main eio.mock cohttp-eio tls-eio mirage-crypto-rng.unix
  x509 uri mtime ptime cstruct domain-name alcotest)
 (deps peer-cert.pem peer-key.pem))

(rule
 (targets peer-cert.pem peer-key.pem)
 (action
  (run openssl req -x509 -newkey rsa:2048 -nodes
   -keyout peer-key.pem -out peer-cert.pem -days 2
   -subj /CN=localhost
   -addext subjectAltName=DNS:localhost
   -addext basicConstraints=critical,CA:TRUE)))

(library
 (name native_lock)
 (wrapped false)
 (modules native_lock)
 (libraries unix)
 (foreign_stubs (language c) (names native_lock_stubs)))

