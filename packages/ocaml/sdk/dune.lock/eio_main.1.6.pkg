(version 1.6)

(build
 (all_platforms
  ((action (run dune build -p %{pkg-self:name} -j %{jobs} @install)))))

(depends
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux)))
   (dune eio_linux eio_posix))
  ((((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   (dune eio_posix))))

(source
 (fetch
  (url
   https://github.com/ocaml-multicore/eio/releases/download/v1.6/eio-1.6.tbz)
  (checksum
   sha512=92ed8cf20300b8a4e0141bdbc373c0803c5a24530cb65852637d905fff4a5b956a8859a00a424034ff78c1112da9b0391194bcd558326168bdebd1ce683a8890)))
