(version 2.1.5)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs}))))))

(depends
 (all_platforms
  (ocaml dune tls mirage-crypto-rng eio ptime)))

(source
 (fetch
  (url
   https://github.com/mirleft/ocaml-tls/releases/download/v2.1.5/tls-2.1.5.tbz)
  (checksum
   sha512=d3dd21291df4a8c377bf379d45adf158d263ed41652709cac0ee846fe2cbff3e2d6cf6e6556f5fd0e9c2087c45ccac622ad4ba41a7b111660e4bc36c7c8647f8)))
