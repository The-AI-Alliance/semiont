(version 0.92)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune ocaml ptime hmap pbrt pbrt_yojson ambient-context mtime eio)))

(source
 (fetch
  (url
   https://github.com/ocaml-tracing/ocaml-opentelemetry/releases/download/v0.92/opentelemetry-0.92.tbz)
  (checksum
   sha512=2a19bf4e371ed2751e018c734ead2fd130d378ef0e018cda7b4aa3048af3e0db771fbd78d936199b34164950454bce0f3cb6211455e3647f7b7a85f4649bb22c)))
