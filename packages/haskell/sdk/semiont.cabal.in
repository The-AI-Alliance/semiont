cabal-version: 3.0
name: semiont
version: @VERSION@
synopsis: Typed Semiont SDK for Haskell
description: Protocol-derived models for the Semiont knowledge platform.
license: Apache-2.0
license-file: LICENSE
category: Network
author: The AI Alliance
maintainer: Semiont contributors
build-type: Simple
extra-source-files: semiont.cabal.in, README.md, run.sh, api.py, public-api.inputs.json, public-api.json, test/refusals.py, test/refusals/*.hs, test/http-peer.py, conformance/README.md, conformance/launch.sh

common settings
  default-language: GHC2021
  ghc-options: -Wall -Wincomplete-patterns -Wincomplete-record-updates
  build-depends:
    base >=4.20 && <4.21,
    aeson >=2.2 && <2.3,
    async >=2.2 && <2.3,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    regex-tdfa >=1.3 && <1.4,
    scientific >=0.3 && <0.4,
    stm >=2.5 && <2.6,
    streaming >=0.2 && <0.3,
    text >=2.1 && <2.2,
    vector >=0.13 && <0.14

common context-propagation
  build-depends: hs-opentelemetry-api >=1.0 && <1.1, http-client >=0.7 && <0.8, http-types >=0.12 && <0.13, case-insensitive >=1.2 && <1.3, network-uri >=2.6 && <2.7, uuid-types >=1.0 && <1.1, unordered-containers >=0.2 && <0.3

library
  default-language: GHC2021
  build-depends: base >=4.20 && <4.21, semiont:internal
  reexported-modules: Semiont.Types, Semiont.Types.Presence, Semiont.Channels, Semiont.Running, Semiont.ErrorCodes, Semiont.Timing, Semiont.Timing.Settings, Semiont.Retry, Semiont.Discovery, Semiont.Discovery.Reasons, Semiont.Transport, Semiont.Transport.Facts, Semiont.StateValue, Semiont.Errors, Semiont.EventBus, Semiont.Bus, Semiont.Http, Semiont.Content, Semiont.Gateway, Semiont.Frame, Semiont.Auth, Semiont.System, Semiont.Client

library internal
  import: settings, context-propagation
  visibility: private
  hs-source-dirs: src, internal, generated
  exposed-modules:
    Semiont.Types
    Semiont.Types.Presence
    Semiont.Channels
    Semiont.Running
    Semiont.ErrorCodes
    Semiont.Timing
    Semiont.Timing.Settings
    Semiont.Retry
    Semiont.Discovery
    Semiont.Discovery.Reasons
    Semiont.Transport
    Semiont.Transport.Facts
    Semiont.StateValue
    Semiont.Errors
    Semiont.EventBus
    Semiont.Bus
    Semiont.Internal.Schema
    Semiont.Internal.Broadcast
    Semiont.Internal.Sse
    Semiont.Internal.Running
    Semiont.Internal.Delivery
    Semiont.Internal.StateValue
    Semiont.Internal.Transport
    Semiont.Http
    Semiont.Content
    Semiont.Gateway
    Semiont.Frame
    Semiont.Auth
    Semiont.System
    Semiont.Client
    Semiont.Internal.Http
    Semiont.Internal.HttpActor
    Semiont.Internal.HttpContent
    Semiont.Internal.Lifetime
    Semiont.Http.Routes
    Semiont.Internal.Generated.Schemas
  other-modules:
    Paths_semiont
    Semiont.Internal.Telemetry
    Semiont.Internal.Codec
    Semiont.Internal.Required
    Semiont.Internal.RetryPolicy
@MODEL_MODULES@
  autogen-modules: Paths_semiont

executable semiont-codegen
  import: settings
  main-is: Main.hs
  hs-source-dirs: codegen, internal
  other-modules: Semiont.Internal.Schema, Facts, TransportFacts, HttpFacts
  ghc-options: -threaded
  build-depends: mtl >=2.3 && <2.4, directory >=1.3 && <1.4, filepath >=1.5 && <1.6

test-suite schema-cases
  import: settings, context-propagation
  build-tool-depends: hpc-codecov:hpc-codecov ==0.6.4.1
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules: Semiont.Internal.Generated.RoundTrip, Semiont.Internal.Generated.ChannelRoundTrip, Semiont.Internal.Generated.ErrorRoundTrip, Semiont.Internal.Generated.TimingValues, Semiont.Internal.Generated.DiscoveryReasonRoundTrip, Runtime, Discovery, BusCases, SchemaCases, HttpCases, LifetimeCases
  ghc-options: -threaded
  build-depends: semiont:internal, process >=1.6 && <1.7, directory >=1.3 && <1.4, filepath >=1.5 && <1.6

executable semiont-haskell-wire-driver
  import: settings
  main-is: Main.hs
  hs-source-dirs: conformance
  ghc-options: -threaded
  build-depends: semiont, http-client >=0.7 && <0.8, uuid >=1.3 && <1.4, uuid-types >=1.0 && <1.1, random >=1.3 && <1.4, base64-bytestring >=1.2 && <1.3, hs-opentelemetry-sdk >=1.0 && <1.1
