{
  "about": "one of the gateway's own operations refused 429 refusal-rate is renewed, not waited out; refused again, it fails as unauthorized with its 429, never as rate-limited, is reported, and is not sent a third time",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § A refused credential; specs/src/components/schemas/LimitRefusal.json",
  "steps": [
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}, "renewals": [{"$var": "token2"}, "never-asked"]}},
    {"wire": "POST /bus/subscribe", "status": 200, "token": {"$var": "token"}, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"backend": "refuse", "with": {"wire": "GET /api/users/me", "status": 429, "retryAfter": 1, "body": {"error": "The requests this holder has had refused have used their allowance", "code": "refusal-rate"}, "times": 2}},
    {"driver": "current-user", "fails": {"code": "unauthorized", "status": 429}},
    {"wire": "GET /api/users/me", "status": 429, "token": {"$var": "token"}},
    {"wire": "GET /api/users/me", "status": 429, "token": {"$var": "token2"}},
    {"error": {"code": "unauthorized", "status": 429}},
    {"quiet": 300}
  ]
}
