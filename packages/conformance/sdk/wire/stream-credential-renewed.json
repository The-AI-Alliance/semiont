{
  "about": "a stream refused 401 is reported as unauthorized, asks the client's refresher once, and opens with the token it gives",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § A refused credential; specs/src/components/schemas/LimitRefusal.json",
  "steps": [
    {"backend": "refuse", "with": {"wire": "POST /bus/subscribe", "status": 401, "headers": {"WWW-Authenticate": "Bearer error=\"invalid_token\", resource_metadata=\"http://gateway.test/.well-known/oauth-protected-resource\""}, "body": {"error": "Invalid token"}, "times": 1}},
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}, "renewals": [{"$var": "token2"}, "never-asked"]}},
    {"wire": "POST /bus/subscribe", "status": 401, "token": {"$var": "token"}, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"error": {"code": "unauthorized", "status": 401}},
    {"wire": "POST /bus/subscribe", "status": 200, "token": {"$var": "token2"}, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"quiet": 300}
  ]
}
