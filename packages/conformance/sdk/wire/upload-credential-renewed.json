{
  "about": "an upload refused 401 asks the client's refresher once and is sent again whole with the token it gives; it resolves as if never refused, and nothing is reported",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md \u00a7 A refused credential, \u00a7 Content and the gateway's own operations",
  "steps": [
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}, "renewals": [{"$var": "token2"}, "never-asked"]}},
    {"wire": "POST /bus/subscribe", "status": 200, "token": {"$var": "token"}, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"backend": "refuse", "with": {"wire": "POST /resources", "status": 401, "headers": {"WWW-Authenticate": "Bearer error=\"invalid_token\", resource_metadata=\"http://gateway.test/.well-known/oauth-protected-resource\""}, "body": {"error": "Invalid token"}, "times": 1}},
    {"driver": "put", "with": {"name": "Renewed", "format": "text/plain", "storageUri": "file://uploads/renewed.txt", "bytes": "c2VudCB0d2ljZSwga2VwdCBvbmNl"}, "returns": {"resourceId": {"$var": "uploaded"}}},
    {"wire": "POST /resources", "status": 401, "token": {"$var": "token"}},
    {"wire": "POST /resources", "status": 202, "token": {"$var": "token2"}, "answer": {"resourceId": {"$var": "uploaded"}}},
    {"backend": "uploaded", "with": {"resource": {"$var": "uploaded"}, "bytes": "c2VudCB0d2ljZSwga2VwdCBvbmNl", "fields": {"name": "Renewed", "format": "text/plain", "storageUri": "file://uploads/renewed.txt"}}},
    {"quiet": 300}
  ]
}
