    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "mark:added", "sequence": 514, "live": true}},
    {"frame": "mark:added", "is": {"payload": {"$var": "_"}, "scope": {"$var": "r1"}}},
    {"stays": "open"}
  ]
