{
  "about": "an emit refused 401 asks the client's refresher once, is sent again at once with the token it gives, and settles as if it had never been refused: nothing is reported",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § A refused credential; specs/src/components/schemas/LimitRefusal.json",
  "steps": [
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}, "renewals": [{"$var": "token2"}, "never-asked"]}},
    {"wire": "POST /bus/subscribe", "status": 200, "token": {"$var": "token"}, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"backend": "refuse", "with": {"wire": "POST /bus/emit", "status": 401, "headers": {"WWW-Authenticate": "Bearer error=\"invalid_token\", resource_metadata=\"http://gateway.test/.well-known/oauth-protected-resource\""}, "body": {"error": "Invalid token"}, "times": 1}},
    {"driver": "emit", "with": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}}, "as": "emitted"},
    {"wire": "POST /bus/emit", "status": 401, "token": {"$var": "token"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"wire": "POST /bus/emit", "status": 202, "token": {"$var": "token2"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"settles": "emitted"},
    {"quiet": 300}
  ]
}
