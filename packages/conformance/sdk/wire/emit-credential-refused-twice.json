{
  "about": "an emit whose renewed token is refused too fails as unauthorized with the status it was answered, never as rate-limited, is reported on the error stream, and is not sent a third time",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § A refused credential; specs/src/components/schemas/LimitRefusal.json",
  "steps": [
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}, "renewals": [{"$var": "token2"}, "never-asked"]}},
    {"wire": "POST /bus/subscribe", "status": 200, "token": {"$var": "token"}, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"backend": "refuse", "with": {"wire": "POST /bus/emit", "status": 429, "retryAfter": 1, "body": {"error": "The requests this holder has had refused have used their allowance", "code": "refusal-rate"}, "times": 2}},
    {"driver": "emit", "with": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}}, "fails": {"code": "unauthorized", "status": 429}},
    {"wire": "POST /bus/emit", "status": 429, "token": {"$var": "token"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"wire": "POST /bus/emit", "status": 429, "token": {"$var": "token2"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"error": {"code": "unauthorized", "status": 429}},
    {"quiet": 300}
  ]
}
