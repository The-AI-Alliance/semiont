{
  "about": "an upload reports its progress as it is sent: how much has gone and how much there is, never less than it last said, and all of it by the time the upload resolves",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § Content and the gateway's own operations; specs/src/paths/resources.json",
  "steps": [
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"driver": "upload", "with": {"name": "Every byte", "format": "image/png", "storageUri": "file://uploads/progress.png", "bytes": ""}, "as": "sent"},
    {"wire": "POST /resources", "status": 202, "answer": {"resourceId": {"$var": "uploaded"}}},
    {"progress": "sent"},
    {"settles": "sent", "returns": {"resourceId": {"$var": "uploaded"}}}
  ]
}
