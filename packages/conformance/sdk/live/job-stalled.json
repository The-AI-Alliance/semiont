{
  "about": "a generation that says nothing: its follower gives up on it once its stall deadline has passed with nothing heard, asks for that job to be cancelled, by its id and no other, and ends as stalled under the code every SDK reports it by; a frame of the job starts the deadline again, and the deadline the caller stated is not sent to the knowledge base",
  "source": "docs/protocol/JOBS.md § Following a job; specs/src/errors/codes.json job",
  "tier": "parity",
  "steps": [
    {
      "let": {
        "params": {
          "title": "A summary",
          "storageUri": "file://a-summary.md",
          "context": {
            "focus": {
              "kind": "resource",
              "resource": {
                "@context": "https://schema.org/",
                "@id": "res-one",
                "name": "one",
                "representations": []
              }
            },
            "graph": {
              "nodes": [],
              "edges": []
            },
            "metadata": {}
          }
        }
      }
    },
    {
      "backend": "listen",
      "with": {
        "channels": [
          "job:create",
          "job:status-requested",
          "job:cancel-requested"
        ]
      }
    },
    {
      "driver": "open",
      "with": {
        "timing": {
          "busRequestTimeoutMs": 5000,
          "invalidationWindowMs": 100,
          "reconnectMs": 50,
          "lazyRemoveMs": 50,
          "lingerMs": 50,
          "jobSilenceMs": 60000,
          "jobStatusPollMs": 60000
        }
      }
    },
    {
      "state": "open"
    },
    {
      "driver": "yieldDelegate",
      "with": {
        "observer": "job",
        "params": {
          "$var": "params"
        },
        "stallDeadlineMs": 2000
      }
    },
    {
      "fetch": "job:create",
      "payload": {
        "jobType": "yield",
        "params": {
          "$var": "params"
        }
      },
      "as": "c1"
    },
    {
      "backend": "emit",
      "with": {
        "channel": "job:created",
        "correlationId": {
          "$var": "c1"
        },
        "payload": {
          "response": {
            "jobId": "job-1"
          }
        }
      }
    },
    {
      "quiet": 1200
    },
    {
      "backend": "emit",
      "with": {
        "channel": "job:report-progress",
        "payload": {
          "resourceId": "res-one",
          "jobId": "job-1",
          "jobType": "yield",
          "percentage": 10,
          "progress": {
            "percentage": 10
          }
        }
      }
    },
    {
      "reaches": "job",
      "state": {
        "status": "ready",
        "value": {
          "kind": "progress",
          "data": {
            "percentage": 10
          }
        }
      }
    },
    {
      "quiet": 1200
    },
    {
      "fetch": "job:cancel-requested",
      "payload": {
        "jobId": "job-1"
      },
      "as": "k1"
    },
    {
      "reaches": "job",
      "state": {
        "status": "failed",
        "error": {
          "code": "job.stalled"
        }
      }
    },
    {
      "backend": "emit",
      "with": {
        "channel": "job:cancel-ok",
        "correlationId": {
          "$var": "k1"
        },
        "payload": {
          "response": {
            "cancelled": true
          }
        }
      }
    },
    {
      "quiet": 300
    }
  ]
}
