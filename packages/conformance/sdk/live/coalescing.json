{
  "about": "events arriving together refresh an observed key at once for the first, and once more, when the window closes, for all that came inside it (B19)",
  "source": "docs/protocol/CACHE-SEMANTICS.md B19; specs/src/client/timing.json invalidationWindowMs",
  "tier": "parity",
  "steps": [
