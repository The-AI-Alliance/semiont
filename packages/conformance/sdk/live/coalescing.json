    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "mark:added", "sequence": 1, "live": true}},
    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "mark:added", "sequence": 2, "live": true}},
    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "mark:added", "sequence": 3, "live": true}},
    {"fetch": "browse:events-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f2"},
    {"backend": "emit", "with": {"channel": "browse:events-result", "correlationId": {"$var": "f2"}, "payload": {"response": {"events": [], "total": 0, "resourceId": {"$var": "r1"}}}}},
    {"fetch": "browse:events-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f3"},
    {"backend": "emit", "with": {"channel": "browse:events-result", "correlationId": {"$var": "f3"}, "payload": {"response": {"events": [{"id": "event-1", "type": "mark:added", "timestamp": "2026-01-01T00:00:00.000Z", "userId": {"$var": "client"}, "resourceId": {"$var": "r1"}, "version": 1, "payload": {}, "metadata": {"sequenceNumber": 1}, "agent": {"@type": "Person", "@id": {"$var": "client"}}}], "total": 1, "resourceId": {"$var": "r1"}}}}},
    {"reaches": "a", "state": {"status": "ready", "value": [{"id": "event-1", "type": "mark:added", "timestamp": "2026-01-01T00:00:00.000Z", "userId": {"$var": "client"}, "resourceId": {"$var": "r1"}, "version": 1, "payload": {}, "metadata": {"sequenceNumber": 1}, "agent": {"@type": "Person", "@id": {"$var": "client"}}}]}},
    {"quiet": 900}
  ]
