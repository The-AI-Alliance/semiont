{
  "about": "an event on an observed resource makes the client ask again for what is observed, which keeps its value until the new one arrives; what nobody has observed is not asked for, and an event on a resource nobody observes never reaches the client (B7)",
  "source": "docs/protocol/CACHE-SEMANTICS.md B7; specs/src/client/refresh.json",
  "tier": "fleet",
  "steps": [
    {"backend": "listen", "with": {"channels": ["browse:resource-requested", "browse:annotation-requested", "browse:events-requested", "gather:referenced-by-requested", "browse:resources-requested", "browse:entity-types-requested", "browse:tag-schemas-requested"]}},
    {"driver": "open", "with": {"timing": {"busRequestTimeoutMs": 5000, "invalidationWindowMs": 100, "reconnectMs": 50, "lazyRemoveMs": 50, "lingerMs": 50}}},
    {"state": "open"},

    {"observe": {"query": "events", "resource": {"$var": "r1"}}, "as": "a"},
    {"fetch": "browse:events-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f1"},
    {"backend": "emit", "with": {"channel": "browse:events-result", "correlationId": {"$var": "f1"}, "payload": {"response": {"events": [], "total": 0, "resourceId": {"$var": "r1"}}}}},
    {"reaches": "a", "state": {"status": "ready", "value": []}},
    {"scopes": [{"$var": "r1"}]},

    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "mark:added", "sequence": 1, "live": true}},
    {"fetch": "browse:events-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f2"},
    {"holds": "a", "state": {"status": "ready", "value": []}},
    {"backend": "emit", "with": {"channel": "browse:events-result", "correlationId": {"$var": "f2"}, "payload": {"response": {"events": [{"id": "event-1", "type": "mark:added", "timestamp": "2026-01-01T00:00:00.000Z", "userId": {"$var": "client"}, "resourceId": {"$var": "r1"}, "version": 1, "payload": {}, "metadata": {"sequenceNumber": 1}, "agent": {"@type": "Person", "@id": {"$var": "client"}}}], "total": 1, "resourceId": {"$var": "r1"}}}}},
    {"reaches": "a", "state": {"status": "ready", "value": [{"id": "event-1", "type": "mark:added", "timestamp": "2026-01-01T00:00:00.000Z", "userId": {"$var": "client"}, "resourceId": {"$var": "r1"}, "version": 1, "payload": {}, "metadata": {"sequenceNumber": 1}, "agent": {"@type": "Person", "@id": {"$var": "client"}}}]}},

    {"backend": "record", "with": {"resource": {"$var": "r2"}, "channel": "mark:added", "sequence": 1, "live": true}},
    {"quiet": 400}
  ]
}
