# What any project, tool or editor leaves anywhere in the tree. What one
# project's build makes is in that project's own .gitignore.

# npm installs: the workspace root's, and each npm project's under tests/
node_modules

# Build output and coverage, as every language here writes them
dist/
build/
coverage/
*.lcov
*.tsbuildinfo

# Python: an environment, and what the interpreter and its tools cache, in
# each of the projects under packages/python/ and images/
.venv/
__pycache__/
.mypy_cache/
.pytest_cache/
.hypothesis/
.ruff_cache/

# Environment files, and the backups tooling writes beside them
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.backup*

# Logs, temporary files and caches
logs
*.log
tmp/
temp/
*.tmp
*.temp
.cache/

# Operating systems
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# The symbols a compliance report discovers, beside the script of each
# project that runs one (scripts/compliance/README.md)
**/scripts/symbols.json

# What the repository's own tooling writes at its root: the packages staged
# for a registry (scripts/ci/build.sh, publish.sh), the compliance reports,
# the release notes' context (scripts/release/notes-context.sh, which quotes
# .plans verbatim), and the ephemeral planning documents
/.npm-stage/
/.compliance/
/.release-notes-context.md
/.plans
