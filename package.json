{
  "name": "semiont",
  "version": "0.7.1",
  "private": true,
  "description": "Semiont - Semantic Knowledge Platform",
  "workspaces": [
    "apps/*",
    "images/*",
    "packages/typescript/*",
    "tests/doc-snippets"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build:packages && npm run build:browser",
    "build:packages": "node scripts/dev/build-packages.js",
    "generate:bus": "node scripts/bus/generate-ts.mjs && node scripts/bus/generate-go.mjs",
    "generate:bus:check": "node scripts/bus/generate-ts.mjs --check && node scripts/bus/generate-go.mjs --check",
    "generate:python": "node scripts/bus/generate-python.mjs && node scripts/spec/generate-identifiers-python.mjs && node scripts/spec/generate-error-codes-python.mjs && node scripts/spec/generate-client-timing-python.mjs && node scripts/spec/generate-cache-refresh-python.mjs && node scripts/spec/generate-sdk-telemetry-python.mjs && node scripts/spec/generate-oauth-clients-python.mjs && node scripts/spec/generate-sign-in-python.mjs && node scripts/spec/generate-stored-python.mjs && node scripts/spec/generate-media-types-python.mjs && node scripts/spec/generate-encodings-python.mjs",
    "generate:python:check": "node scripts/bus/generate-python.mjs --check && node scripts/spec/generate-identifiers-python.mjs --check && node scripts/spec/generate-error-codes-python.mjs --check && node scripts/spec/generate-client-timing-python.mjs --check && node scripts/spec/generate-cache-refresh-python.mjs --check && node scripts/spec/generate-sdk-telemetry-python.mjs --check && node scripts/spec/generate-oauth-clients-python.mjs --check && node scripts/spec/generate-sign-in-python.mjs --check && node scripts/spec/generate-stored-python.mjs --check && node scripts/spec/generate-media-types-python.mjs --check && node scripts/spec/generate-encodings-python.mjs --check",
    "generate:go": "node scripts/spec/generate-identifiers-go.mjs && node scripts/spec/generate-error-codes-go.mjs && node scripts/spec/generate-client-timing-go.mjs && node scripts/spec/generate-cache-refresh-go.mjs && node scripts/spec/generate-sdk-telemetry-go.mjs && node scripts/spec/generate-sign-in-go.mjs && node scripts/spec/generate-oauth-clients-go.mjs && node scripts/spec/generate-media-types-go.mjs && node scripts/spec/generate-encodings-go.mjs",
    "generate:go:check": "node scripts/spec/generate-identifiers-go.mjs --check && node scripts/spec/generate-error-codes-go.mjs --check && node scripts/spec/generate-client-timing-go.mjs --check && node scripts/spec/generate-cache-refresh-go.mjs --check && node scripts/spec/generate-sdk-telemetry-go.mjs --check && node scripts/spec/generate-sign-in-go.mjs --check && node scripts/spec/generate-oauth-clients-go.mjs --check && node scripts/spec/generate-media-types-go.mjs --check && node scripts/spec/generate-encodings-go.mjs --check",
    "generate:stack-go": "node scripts/spec/generate-stack-go.mjs",
    "generate:stack-go:check": "node scripts/spec/generate-stack-go.mjs --check",
    "generate:mcp-tools-go": "node scripts/spec/generate-mcp-tools-go.mjs",
    "generate:mcp-tools-go:check": "node scripts/spec/generate-mcp-tools-go.mjs --check",
    "generate:encoding-cases": "node scripts/spec/generate-encoding-cases.mjs",
    "generate:encoding-cases:check": "node scripts/spec/generate-encoding-cases.mjs --check",
    "generate:model-catalogue": "node scripts/inference/generate-model-catalogue.mjs --out packages/python/inference/tests/catalogue",
    "generate:model-catalogue:check": "node scripts/inference/generate-model-catalogue.mjs --check packages/python/inference/tests/catalogue",
    "build:browser": "npm run build -w semiont-browser",
    "build:all": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:css": "git ls-files -z --cached --others --exclude-standard -- '*.css' | xargs -0 stylelint",
    "lint:css:fix": "git ls-files -z --cached --others --exclude-standard -- '*.css' | xargs -0 stylelint --fix",
    "lint:no-utility-classes": "node scripts/lint/check-no-utility-classes-in-react-ui.js",
    "lint:css-variables": "node scripts/lint/check-css-variables-defined.js",
    "lint:css-classes": "node scripts/lint/check-css-classes-live.js",
    "lint:docs-names": "node scripts/lint/check-docs-names.mjs",
    "build:css": "node scripts/dev/build-css-with-sourcemaps.js",
    "build:css:watch": "node scripts/dev/build-css-with-sourcemaps.js --watch",
    "build:css:prod": "node scripts/dev/build-css-with-sourcemaps.js --production",
    "test": "npm run test --workspaces --if-present",
    "browser:dev": "npm run dev -w semiont-browser",
    "openapi:bundle": "redocly bundle --config specs/redocly.yaml specs/src/openapi.json -o specs/openapi.json && redocly bundle --config specs/redocly.yaml specs/src/archivist/openapi.json -o specs/archivist.openapi.json",
    "openapi:lint": "redocly lint --config specs/redocly.yaml specs/src/openapi.json specs/src/archivist/openapi.json",
    "lint:spec-protocol": "node scripts/spec/check-protocol.mjs",
    "lint:spec-jobs": "node scripts/spec/check-jobs.mjs",
    "lint:spec-archivist": "node scripts/spec/check-archivist.mjs",
    "lint:spec-identifiers": "node scripts/spec/check-identifiers.mjs",
    "lint:spec-stack": "node scripts/spec/check-stack.mjs",
    "lint:spec-case-tables": "node scripts/spec/check-case-tables.mjs",
    "lint:spec-channel-rosters": "node scripts/spec/check-channel-rosters.mjs",
    "lint:spec-reference-forms": "node scripts/spec/check-reference-forms.mjs",
    "lint:spec-offset-units": "node scripts/spec/check-offset-units.mjs",
    "lint:spec-reply-bounds": "node scripts/spec/check-reply-bounds.mjs",
    "lint:service-environment": "node scripts/lint/check-service-environment.mjs",
    "lint:telemetry-doc": "node scripts/lint/check-telemetry-doc.mjs",
    "lint:rust-images": "node scripts/lint/check-rust-images.mjs",
    "lint:rust-toolchain": "node scripts/lint/check-rust-toolchain.mjs",
    "lint:go-toolchain": "node scripts/lint/check-go-toolchain.mjs",
    "lint:kotlin-toolchain": "node scripts/lint/check-kotlin-toolchain.mjs",
    "lint:python-version": "node scripts/lint/check-python-version.mjs",
    "lint:node-version": "node scripts/lint/check-node-version.mjs",
    "lint:nats-version": "node scripts/lint/check-nats-version.mjs",
    "lint:conformance-readmes": "node scripts/lint/check-conformance-readmes.mjs",
    "lint:transport-contract": "node scripts/lint/check-transport-contract.mjs",
    "version:show": "node scripts/release/version.mjs show",
    "version:sync": "node scripts/release/version.mjs sync",
    "version:bump": "./scripts/release/version-bump.sh",
    "version:set": "node scripts/release/version.mjs set",
    "publish:stage-apps": "node scripts/ci/publish-npm-apps.mjs",
    "install:deps": "npm install",
    "clean": "rm -rf node_modules apps/*/node_modules images/*/node_modules packages/typescript/*/node_modules",
    "container:build": "node scripts/container/build-images.js",
    "container:build:gateway": "node scripts/container/build-images.js gateway",
    "container:build:dispatcher": "node scripts/container/build-images.js dispatcher",
    "container:build:archivist": "node scripts/container/build-images.js archivist",
    "container:build:browser": "node scripts/container/build-images.js browser",
    "container:build:all": "node scripts/container/build-images.js all",
    "container:images": "node scripts/container/container-utils.js list",
    "container:clean": "node scripts/container/container-utils.js clean",
    "docker:build": "node scripts/container/build-images.js",
    "docker:build:gateway": "node scripts/container/build-images.js gateway",
    "docker:build:browser": "node scripts/container/build-images.js browser",
    "docker:build:all": "node scripts/container/build-images.js all",
    "docker:images": "node scripts/container/container-utils.js list",
    "docker:clean": "node scripts/container/container-utils.js clean",
    "podman:build": "CONTAINER_RUNTIME=podman node scripts/container/build-images.js",
    "podman:build:gateway": "CONTAINER_RUNTIME=podman node scripts/container/build-images.js gateway",
    "podman:build:browser": "CONTAINER_RUNTIME=podman node scripts/container/build-images.js browser",
    "podman:build:all": "CONTAINER_RUNTIME=podman node scripts/container/build-images.js all",
    "podman:images": "CONTAINER_RUNTIME=podman node scripts/container/container-utils.js list",
    "podman:clean": "CONTAINER_RUNTIME=podman node scripts/container/container-utils.js clean",
    "lint:translations": "node scripts/lint/check-translations-complete.js",
    "lint:core-subpaths": "node scripts/lint/check-core-subpath-isolation.mjs",
    "lint:service-role": "node scripts/lint/check-service-role-agreement.mjs",
    "lint:attribution": "node scripts/lint/check-attribution-one-copy.mjs",
    "lint:trace-field": "node scripts/lint/check-trace-field.mjs",
    "lint:coverage-roster": "node scripts/lint/check-coverage-roster-agreement.mjs",
    "lint:compliance-audits": "node scripts/lint/check-compliance-audits-run.mjs",
    "lint:vitest-coverage": "node scripts/lint/check-vitest-coverage-config.mjs",
    "lint:notice": "node scripts/lint/check-notice-components.mjs",
    "lint:dependabot": "node scripts/lint/check-dependabot-coverage.mjs",
    "lint:broker-boundary": "node scripts/lint/check-broker-boundary.mjs",
    "lint:staging-boundary": "node scripts/lint/check-staging-boundary.mjs",
    "lint:secure-context-apis": "node scripts/lint/check-secure-context-apis.mjs",
    "lint:skips-and-any": "node scripts/lint/check-skips-and-any.mjs",
    "lint:event-tags": "node scripts/lint/check-event-tags.mjs",
    "lint:client-surface": "node scripts/lint/check-client-surface.mjs",
    "lint:state-unit-census": "node scripts/lint/check-state-unit-census.mjs",
    "lint:state-unit-cases": "node scripts/lint/check-state-unit-cases.mjs",
    "lint:internal-deps": "node scripts/lint/check-internal-dep-specifiers.mjs",
    "lint:workflows": "node scripts/lint/check-workflows.mjs",
    "lint:labels": "node scripts/lint/check-labels.mjs",
    "lint:path-globs": "node scripts/lint/check-path-globs.mjs"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@types/react": "^19",
    "ajv": "^8.20.0",
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "esbuild": "^0.28.1",
    "@redocly/openapi-core": {
      "js-yaml": "^4.3.2"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    }
  },
  "devDependencies": {
    "@exodus/bytes": "1.16.0",
    "@opencode-ai/models": "0.0.116",
    "@redocly/cli": "^2.34.0",
    "glob": "^14.0.3",
    "@types/node": "^26.0.0",
    "baseline-browser-mapping": "^2.9.6",
    "smol-toml": "^1.9.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.2"
  },
  "license": "Apache-2.0"
}
