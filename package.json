{
  "name": "semiont",
  "version": "0.6.13",
  "private": true,
  "description": "Semiont - Semantic Knowledge Platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/doc-snippets"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "node scripts/dev/build-packages.js",
    "generate:bus": "node scripts/bus/generate-ts.mjs && node scripts/bus/generate-go.mjs",
    "generate:bus:check": "node scripts/bus/generate-ts.mjs --check && node scripts/bus/generate-go.mjs --check",
    "generate:python": "node scripts/bus/generate-python.mjs && node scripts/spec/generate-identifiers-python.mjs && node scripts/spec/generate-error-codes-python.mjs && node scripts/spec/generate-client-timing-python.mjs && node scripts/spec/generate-cache-refresh-python.mjs && node scripts/spec/generate-sdk-telemetry-python.mjs && node scripts/spec/generate-oauth-clients-python.mjs && node scripts/spec/generate-sign-in-python.mjs && node scripts/spec/generate-media-types-python.mjs",
    "generate:python:check": "node scripts/bus/generate-python.mjs --check && node scripts/spec/generate-identifiers-python.mjs --check && node scripts/spec/generate-error-codes-python.mjs --check && node scripts/spec/generate-client-timing-python.mjs --check && node scripts/spec/generate-cache-refresh-python.mjs --check && node scripts/spec/generate-sdk-telemetry-python.mjs --check && node scripts/spec/generate-oauth-clients-python.mjs --check && node scripts/spec/generate-sign-in-python.mjs --check && node scripts/spec/generate-media-types-python.mjs --check",
    "generate:media-types-go": "node scripts/spec/generate-media-types-go.mjs",
    "generate:media-types-go:check": "node scripts/spec/generate-media-types-go.mjs --check",
    "generate:launcher-contracts": "node scripts/spec/generate-sign-in-go.mjs && node scripts/spec/generate-oauth-clients-go.mjs",
    "generate:launcher-contracts:check": "node scripts/spec/generate-sign-in-go.mjs --check && node scripts/spec/generate-oauth-clients-go.mjs --check",
    "build:apps": "npm run build -w semiont-browser",
    "build:all": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:css": "stylelint '**/*.css' --ignore-path .gitignore",
    "lint:css:fix": "stylelint '**/*.css' --ignore-path .gitignore --fix",
    "lint:no-utility-classes": "node scripts/lint/check-no-utility-classes-in-react-ui.js",
    "lint:css-variables": "node scripts/lint/check-css-variables-defined.js",
    "lint:css-classes": "node scripts/lint/check-css-classes-live.js",
    "lint:docs-names": "node scripts/lint/check-docs-names.mjs",
    "build:css": "node scripts/dev/build-css-with-sourcemaps.js",
    "build:css:watch": "node scripts/dev/build-css-with-sourcemaps.js --watch",
    "build:css:prod": "node scripts/dev/build-css-with-sourcemaps.js --production",
    "test": "npm run test --workspaces --if-present",
    "browser:dev": "npm run dev -w semiont-browser",
    "openapi:bundle": "redocly bundle specs/src/openapi.json -o specs/openapi.json && redocly bundle specs/src/archivist/openapi.json -o specs/archivist.openapi.json",
    "openapi:lint": "redocly lint specs/src/openapi.json specs/src/archivist/openapi.json",
    "openapi:validate": "redocly lint specs/openapi.json specs/archivist.openapi.json",
    "lint:spec-protocol": "node scripts/spec/check-protocol.mjs",
    "lint:spec-jobs": "node scripts/spec/check-jobs.mjs",
    "lint:spec-archivist": "node scripts/spec/check-archivist.mjs",
    "lint:spec-identifiers": "node scripts/spec/check-identifiers.mjs",
    "lint:service-environment": "node scripts/lint/check-service-environment.mjs",
    "lint:rust-images": "node scripts/lint/check-rust-images.mjs",
    "lint:rust-toolchain": "node scripts/lint/check-rust-toolchain.mjs",
    "lint:conformance-readmes": "node scripts/lint/check-conformance-readmes.mjs",
    "lint:transport-contract": "node scripts/lint/check-transport-contract.mjs",
    "version:show": "node scripts/release/version.mjs show",
    "version:sync": "node scripts/release/version.mjs sync",
    "version:bump": "./scripts/release/version-bump.sh",
    "version:set": "node scripts/release/version.mjs set",
    "publish:stage-apps": "node scripts/ci/publish-npm-apps.mjs",
    "install:deps": "npm install",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "container:build": "node scripts/container/build-images.js",
    "container:build:gateway": "node scripts/container/build-images.js gateway",
    "container:build:dispatcher": "node scripts/container/build-images.js dispatcher",
    "container:build:archivist": "node scripts/container/build-images.js archivist",
    "container:build:browser": "node scripts/container/build-images.js browser",
    "container:build:all": "node scripts/container/build-images.js all",
    "container:images": "node scripts/container/container-utils.js list",
    "container:clean": "node scripts/container/container-utils.js clean",
    "docker:build": "node scripts/container/build-images.js",
    "docker:build:gateway": "node scripts/container/build-images.js gateway",
    "docker:build:browser": "node scripts/container/build-images.js browser",
    "docker:build:all": "node scripts/container/build-images.js all",
    "docker:images": "node scripts/container/container-utils.js list",
    "docker:clean": "node scripts/container/container-utils.js clean",
    "podman:build": "CONTAINER_RUNTIME=podman node scripts/container/build-images.js",
    "podman:build:gateway": "CONTAINER_RUNTIME=podman node scripts/container/build-images.js gateway",
    "podman:build:browser": "CONTAINER_RUNTIME=podman node scripts/container/build-images.js browser",
    "podman:build:all": "CONTAINER_RUNTIME=podman node scripts/container/build-images.js all",
    "podman:images": "CONTAINER_RUNTIME=podman node scripts/container/container-utils.js list",
    "podman:clean": "CONTAINER_RUNTIME=podman node scripts/container/container-utils.js clean",
    "lint:translations": "node scripts/lint/check-translations-complete.js",
    "lint:core-subpaths": "node scripts/lint/check-core-subpath-isolation.mjs",
    "lint:service-role": "node scripts/lint/check-service-role-agreement.mjs",
    "lint:attribution": "node scripts/lint/check-attribution-one-copy.mjs",
    "lint:coverage-roster": "node scripts/lint/check-coverage-roster-agreement.mjs",
    "lint:vitest-coverage": "node scripts/lint/check-vitest-coverage-config.mjs",
    "lint:notice": "node scripts/lint/check-notice-components.mjs",
    "lint:dependabot": "node scripts/lint/check-dependabot-coverage.mjs",
    "lint:broker-boundary": "node scripts/lint/check-broker-boundary.mjs",
    "lint:staging-boundary": "node scripts/lint/check-staging-boundary.mjs",
    "lint:placeholder-readers": "node scripts/lint/check-placeholder-readers.mjs",
    "lint:secure-context-apis": "node scripts/lint/check-secure-context-apis.mjs",
    "lint:client-surface": "node scripts/lint/check-client-surface.mjs",
    "lint:internal-deps": "node scripts/lint/check-internal-dep-specifiers.mjs"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@types/react": "^19",
    "ajv": "^8.20.0",
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "esbuild": "^0.28.1",
    "@redocly/openapi-core": {
      "js-yaml": "^4.3.2"
    },
    "@qdrant/js-client-rest": {
      "undici": "^7.29.1"
    }
  },
  "devDependencies": {
    "@redocly/cli": "^2.34.0",
    "glob": "^13.0.6",
    "@types/node": "^26.0.0",
    "baseline-browser-mapping": "^2.9.6",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.2"
  },
  "license": "Apache-2.0"
}
