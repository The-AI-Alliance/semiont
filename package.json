{
  "name": "semiont",
  "version": "0.7.1",
  "private": true,
  "description": "Semiont - Semantic Knowledge Platform",
  "workspaces": [
    "apps/*",
    "images/*",
    "packages/typescript/*",
    "tests/doc-snippets"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build:packages && npm run build:browser",
    "build:packages": "node packages/typescript/scripts/build-packages.js",
    "generate:bus": "node packages/codegen/bus/generate-ts.mjs && node packages/codegen/bus/generate-go.mjs",
    "generate:bus:check": "node packages/codegen/bus/generate-ts.mjs --check && node packages/codegen/bus/generate-go.mjs --check",
    "generate:python": "node packages/codegen/bus/generate-python.mjs && node packages/codegen/schemas/generate-identifiers-python.mjs && node packages/codegen/schemas/generate-error-codes-python.mjs && node packages/codegen/schemas/generate-client-timing-python.mjs && node packages/codegen/schemas/generate-cache-refresh-python.mjs && node packages/codegen/schemas/generate-sdk-telemetry-python.mjs && node packages/codegen/schemas/generate-oauth-clients-python.mjs && node packages/codegen/schemas/generate-sign-in-python.mjs && node packages/codegen/schemas/generate-stored-python.mjs && node packages/codegen/schemas/generate-media-types-python.mjs && node packages/codegen/schemas/generate-encodings-python.mjs",
    "generate:python:check": "node packages/codegen/bus/generate-python.mjs --check && node packages/codegen/schemas/generate-identifiers-python.mjs --check && node packages/codegen/schemas/generate-error-codes-python.mjs --check && node packages/codegen/schemas/generate-client-timing-python.mjs --check && node packages/codegen/schemas/generate-cache-refresh-python.mjs --check && node packages/codegen/schemas/generate-sdk-telemetry-python.mjs --check && node packages/codegen/schemas/generate-oauth-clients-python.mjs --check && node packages/codegen/schemas/generate-sign-in-python.mjs --check && node packages/codegen/schemas/generate-stored-python.mjs --check && node packages/codegen/schemas/generate-media-types-python.mjs --check && node packages/codegen/schemas/generate-encodings-python.mjs --check",
    "generate:go": "node packages/codegen/schemas/generate-identifiers-go.mjs && node packages/codegen/schemas/generate-error-codes-go.mjs && node packages/codegen/schemas/generate-client-timing-go.mjs && node packages/codegen/schemas/generate-cache-refresh-go.mjs && node packages/codegen/schemas/generate-sdk-telemetry-go.mjs && node packages/codegen/schemas/generate-sign-in-go.mjs && node packages/codegen/schemas/generate-oauth-clients-go.mjs && node packages/codegen/schemas/generate-media-types-go.mjs && node packages/codegen/schemas/generate-encodings-go.mjs && node packages/codegen/schemas/generate-required-go.mjs",
    "generate:go:check": "node packages/codegen/schemas/generate-identifiers-go.mjs --check && node packages/codegen/schemas/generate-error-codes-go.mjs --check && node packages/codegen/schemas/generate-client-timing-go.mjs --check && node packages/codegen/schemas/generate-cache-refresh-go.mjs --check && node packages/codegen/schemas/generate-sdk-telemetry-go.mjs --check && node packages/codegen/schemas/generate-sign-in-go.mjs --check && node packages/codegen/schemas/generate-oauth-clients-go.mjs --check && node packages/codegen/schemas/generate-media-types-go.mjs --check && node packages/codegen/schemas/generate-encodings-go.mjs --check && node packages/codegen/schemas/generate-required-go.mjs --check",
    "generate:stack-go": "node packages/codegen/schemas/generate-stack-go.mjs",
    "generate:stack-go:check": "node packages/codegen/schemas/generate-stack-go.mjs --check",
    "generate:mcp-tools-go": "node packages/codegen/schemas/generate-mcp-tools-go.mjs",
    "generate:mcp-tools-go:check": "node packages/codegen/schemas/generate-mcp-tools-go.mjs --check",
    "generate:encoding-cases": "node packages/codegen/schemas/generate-encoding-cases.mjs",
    "generate:encoding-cases:check": "node packages/codegen/schemas/generate-encoding-cases.mjs --check",
    "generate:model-catalogue": "node packages/python/inference/scripts/generate-model-catalogue.mjs --out packages/python/inference/tests/catalogue",
    "generate:model-catalogue:check": "node packages/python/inference/scripts/generate-model-catalogue.mjs --check packages/python/inference/tests/catalogue",
    "build:browser": "npm run build -w semiont-browser",
    "build:all": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:css": "git ls-files -z --cached --others --exclude-standard -- '*.css' | xargs -0 stylelint",
    "lint:css:fix": "git ls-files -z --cached --others --exclude-standard -- '*.css' | xargs -0 stylelint --fix",
    "lint:no-utility-classes": "node packages/typescript/react-ui/scripts/check-no-utility-classes-in-react-ui.cjs",
    "lint:css-variables": "node packages/typescript/react-ui/scripts/check-css-variables-defined.cjs",
    "lint:css-classes": "node packages/typescript/react-ui/scripts/check-css-classes-live.cjs",
    "lint:docs-names": "node .github/scripts/checks/check-docs-names.mjs",
    "build:css": "node packages/typescript/react-ui/scripts/build-css-with-sourcemaps.cjs",
    "build:css:watch": "node packages/typescript/react-ui/scripts/build-css-with-sourcemaps.cjs --watch",
    "build:css:prod": "node packages/typescript/react-ui/scripts/build-css-with-sourcemaps.cjs --production",
    "test": "npm run test --workspaces --if-present",
    "browser:dev": "npm run dev -w semiont-browser",
    "openapi:bundle": "redocly bundle --config specs/redocly.yaml specs/src/openapi.json -o specs/openapi.json && redocly bundle --config specs/redocly.yaml specs/src/archivist/openapi.json -o specs/archivist.openapi.json",
    "openapi:lint": "redocly lint --config specs/redocly.yaml specs/src/openapi.json specs/src/archivist/openapi.json",
    "lint:spec-protocol": "node .github/scripts/checks/specs/check-protocol.mjs",
    "lint:spec-jobs": "node .github/scripts/checks/specs/check-jobs.mjs",
    "lint:spec-archivist": "node .github/scripts/checks/specs/check-archivist.mjs",
    "lint:spec-identifiers": "node .github/scripts/checks/specs/check-identifiers.mjs",
    "lint:spec-stack": "node .github/scripts/checks/specs/check-stack.mjs",
    "lint:spec-case-tables": "node .github/scripts/checks/specs/check-case-tables.mjs",
    "lint:spec-channel-rosters": "node .github/scripts/checks/specs/check-channel-rosters.mjs",
    "lint:spec-reference-forms": "node .github/scripts/checks/specs/check-reference-forms.mjs",
    "lint:spec-offset-units": "node .github/scripts/checks/specs/check-offset-units.mjs",
    "lint:spec-reply-bounds": "node .github/scripts/checks/specs/check-reply-bounds.mjs",
    "lint:service-environment": "node images/scripts/check-service-environment.mjs",
    "lint:telemetry-doc": "node .github/scripts/checks/check-telemetry-doc.mjs",
    "lint:rust-images": "node images/scripts/check-rust-images.mjs",
    "lint:rust-toolchain": "node .github/scripts/checks/check-rust-toolchain.mjs",
    "lint:go-toolchain": "node .github/scripts/checks/check-go-toolchain.mjs",
    "lint:swift-toolchain": "node .github/scripts/checks/check-swift-toolchain.mjs",
    "lint:kotlin-toolchain": "node .github/scripts/checks/check-kotlin-toolchain.mjs",
    "lint:python-version": "node .github/scripts/checks/check-python-version.mjs",
    "lint:node-version": "node .github/scripts/checks/check-node-version.mjs",
    "lint:nats-version": "node .github/scripts/checks/check-nats-version.mjs",
    "lint:conformance-readmes": "node tests/conformance/scripts/check-conformance-readmes.mjs",
    "lint:transport-contract": "node .github/scripts/checks/check-transport-contract.mjs",
    "version:show": "node scripts/release/version.mjs show",
    "version:sync": "node scripts/release/version.mjs sync",
    "version:bump": "./scripts/release/version-bump.sh",
    "version:set": "node scripts/release/version.mjs set",
    "publish:stage-apps": "node packages/typescript/scripts/publish-npm-apps.mjs",
    "install:deps": "npm install",
    "clean": "rm -rf node_modules apps/*/node_modules images/*/node_modules packages/typescript/*/node_modules",
    "container:build": "node images/scripts/build-images.js",
    "container:build:gateway": "node images/scripts/build-images.js gateway",
    "container:build:dispatcher": "node images/scripts/build-images.js dispatcher",
    "container:build:archivist": "node images/scripts/build-images.js archivist",
    "container:build:browser": "node images/scripts/build-images.js browser",
    "container:build:all": "node images/scripts/build-images.js all",
    "container:images": "node images/scripts/container-utils.js list",
    "container:clean": "node images/scripts/container-utils.js clean",
    "docker:build": "node images/scripts/build-images.js",
    "docker:build:gateway": "node images/scripts/build-images.js gateway",
    "docker:build:browser": "node images/scripts/build-images.js browser",
    "docker:build:all": "node images/scripts/build-images.js all",
    "docker:images": "node images/scripts/container-utils.js list",
    "docker:clean": "node images/scripts/container-utils.js clean",
    "podman:build": "CONTAINER_RUNTIME=podman node images/scripts/build-images.js",
    "podman:build:gateway": "CONTAINER_RUNTIME=podman node images/scripts/build-images.js gateway",
    "podman:build:browser": "CONTAINER_RUNTIME=podman node images/scripts/build-images.js browser",
    "podman:build:all": "CONTAINER_RUNTIME=podman node images/scripts/build-images.js all",
    "podman:images": "CONTAINER_RUNTIME=podman node images/scripts/container-utils.js list",
    "podman:clean": "CONTAINER_RUNTIME=podman node images/scripts/container-utils.js clean",
    "lint:translations": "node .github/scripts/checks/check-translations-complete.js",
    "lint:core-subpaths": "node packages/typescript/core/scripts/check-core-subpath-isolation.mjs",
    "lint:service-role": "node .github/scripts/checks/check-service-role-agreement.mjs",
    "lint:attribution": "node images/archivist/scripts/check-attribution-one-copy.mjs",
    "lint:trace-field": "node .github/scripts/checks/check-trace-field.mjs",
    "lint:coverage-roster": "node .github/scripts/checks/check-coverage-roster-agreement.mjs",
    "lint:compliance-audits": "node .github/scripts/checks/check-compliance-audits-run.mjs",
    "lint:vitest-coverage": "node .github/scripts/checks/check-vitest-coverage-config.mjs",
    "lint:notice": "node images/scripts/check-notice-components.mjs",
    "lint:dependabot": "node .github/scripts/checks/check-dependabot-coverage.mjs",
    "lint:broker-boundary": "node images/scripts/check-broker-boundary.mjs",
    "lint:staging-boundary": "node images/archivist/scripts/check-staging-boundary.mjs",
    "lint:secure-context-apis": "node .github/scripts/checks/check-secure-context-apis.mjs",
    "lint:skips-and-any": "node .github/scripts/checks/check-skips-and-any.mjs",
    "lint:event-tags": "node .github/scripts/checks/check-event-tags.mjs",
    "lint:client-surface": "node .github/scripts/checks/check-client-surface.mjs",
    "lint:state-unit-census": "node .github/scripts/checks/check-state-unit-census.mjs",
    "lint:state-unit-cases": "node .github/scripts/checks/check-state-unit-cases.mjs",
    "lint:internal-deps": "node .github/scripts/checks/check-internal-dep-specifiers.mjs",
    "lint:workflows": "node .github/scripts/checks/check-workflows.mjs",
    "lint:labels": "node .github/scripts/checks/check-labels.mjs",
    "lint:path-globs": "node .github/scripts/checks/check-path-globs.mjs"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@types/react": "^19",
    "ajv": "^8.20.0",
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "esbuild": "^0.28.1",
    "@redocly/openapi-core": {
      "js-yaml": "^4.3.2"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    }
  },
  "devDependencies": {
    "@exodus/bytes": "1.16.0",
    "@opencode-ai/models": "0.0.116",
    "@redocly/cli": "^2.34.0",
    "glob": "^14.0.3",
    "@types/node": "^26.0.0",
    "baseline-browser-mapping": "^2.9.6",
    "smol-toml": "^1.9.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.2"
  },
  "license": "Apache-2.0"
}
