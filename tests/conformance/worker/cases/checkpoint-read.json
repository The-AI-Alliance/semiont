{
  "about": "a claimed record's finished units and cursors are the checkpoint earlier attempts left, and a worker holds them as the record states them",
  "source": "docs/protocol/WORKER-CONTRACT.md § The claimed record",
  "steps": [
    {"let": {"accepts": [{"jobType": "mark", "params": {"motivation": "highlighting"}}]}},
    {"let": {"cursors": {"Place": {"next": 1200, "size": 800, "found": 4, "emitted": 3, "errors": 1}}}},
    {"let": {"job": {"status": "running", "metadata": {"id": "job-1", "type": "mark", "userId": {"$var": "client"}, "created": "2026-01-01T00:00:00.000Z", "retryCount": 2, "maxRetries": 3, "completedUnits": ["Person"], "unitCursors": {"$var": "cursors"}}, "params": {"resourceId": {"$var": "r1"}, "motivation": "highlighting"}, "startedAt": "2026-01-01T00:00:01.000Z", "progress": {}}}},
    {"backend": "listen", "with": {"channels": ["job:claim"]}},
    {"driver": "open", "with": {"timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "body": {"clientId": {"$var": "clientId"}, "global": ["job:cancel-requested", "job:claim-failed", "job:claimed", "job:queued"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"driver": "claim", "with": {"accepts": {"$var": "accepts"}}},
    {"wire": "POST /bus/emit", "status": 202, "body": {"channel": "job:claim", "payload": {"accepts": {"$var": "accepts"}}, "correlationId": {"$var": "c1"}, "clientId": {"$var": "clientId"}}},
    {"backend": "emit", "with": {"channel": "job:claimed", "correlationId": {"$var": "c1"}, "payload": {"response": {"$var": "job"}}}},
    {"claimed": {"jobId": "job-1", "jobType": "mark", "resourceId": {"$var": "r1"}, "params": {"resourceId": {"$var": "r1"}, "motivation": "highlighting"}, "completedUnits": ["Person"], "unitCursors": {"$var": "cursors"}, "retryCount": 2, "maxRetries": 3}},
    {"quiet": 200}
  ]
}
