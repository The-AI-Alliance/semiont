{
  "about": "a stream refused as unauthorized is reported, and the refused credential is not sent again: the client waits, and opens its stream when it is given another",
  "source": "docs/protocol/TRANSPORT-HTTP.md § Connection lifecycle, § Reconnect discipline",
  "steps": [
    {"driver": "open", "with": {"token": "not-a-token", "channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 401, "token": "not-a-token", "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"error": {"code": "unauthorized", "status": 401}},
    {"state": "unauthenticated"},
    {"quiet": 400},

    {"driver": "set-token", "with": {"token": {"$var": "token"}}},
    {"wire": "POST /bus/subscribe", "status": 200, "token": {"$var": "token"}, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"driver": "emit", "with": {"channel": "beckon:focus", "payload": {}}},
    {"wire": "POST /bus/emit", "status": 202, "token": {"$var": "token"}, "body": {"channel": "beckon:focus", "payload": {}, "clientId": {"$var": "clientId"}}}
  ]
}
