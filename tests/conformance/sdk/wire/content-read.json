{
  "about": "a resource's bytes are read unchanged with their media type, whole or as a stream; its description is what the gateway answers; and a resource that is not there fails as not-found",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § Content and the gateway's own operations; specs/src/paths/resources_{id}.json, resources_{id}_jsonld.json",
  "steps": [
    {"let": {"graph": {"resource": {"@context": "https://schema.org/", "@id": "described", "name": "Described", "representations": []}, "annotations": [], "entityReferences": []}}},
    {"backend": "content", "with": {"resource": {"$var": "r1"}, "mediaType": "image/png", "bytes": ""}},
    {"backend": "description", "with": {"resource": {"$var": "r1"}, "graph": {"$var": "graph"}}},
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},

    {"driver": "get", "with": {"resource": {"$var": "r1"}}, "returns": {"contentType": "image/png", "bytes": ""}},
    {"wire": "GET /resources/{id}", "status": 200, "token": {"$var": "token"}, "params": {"id": {"$var": "r1"}}},
    {"driver": "get-stream", "with": {"resource": {"$var": "r1"}}, "returns": {"contentType": "image/png", "bytes": ""}},
    {"wire": "GET /resources/{id}", "status": 200, "params": {"id": {"$var": "r1"}}},
    {"driver": "graph", "with": {"resource": {"$var": "r1"}}, "returns": {"$var": "graph"}},
    {"wire": "GET /resources/{id}/jsonld", "status": 200, "token": {"$var": "token"}, "params": {"id": {"$var": "r1"}}, "answer": {"$var": "graph"}},

    {"driver": "get", "with": {"resource": {"$var": "r2"}}, "fails": {"code": "not-found", "status": 404}},
    {"wire": "GET /resources/{id}", "status": 404, "params": {"id": {"$var": "r2"}}},
    {"error": {"code": "not-found", "status": 404}}
  ]
}
