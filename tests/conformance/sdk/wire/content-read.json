{
  "about": "a resource's bytes are read unchanged with their media type, whole or as a stream; its description is what the gateway answers; its annotations are what the gateway answers; its anchored text is what the gateway answers, the text or that there is none yet; a resource that is not there fails as not-found; and a read of anchored text the gateway refuses fails as a refused read of a description does",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § Content and the gateway's own operations; specs/src/paths/resources_{id}.json, resources_{id}_jsonld.json, resources_{id}_annotations.json, resources_{id}_anchored-text.json",
  "steps": [
    {"let": {"graph": {"resource": {"@context": "https://schema.org/", "@id": "described", "name": "Described", "representations": []}, "annotations": [], "entityReferences": []}}},
    {"let": {"annotations": {"annotations": [{"@context": "http://www.w3.org/ns/anno.jsonld", "type": "Annotation", "id": {"$var": "a1"}, "motivation": "highlighting", "target": {"source": {"$var": "r1"}}, "created": "2026-01-01T00:00:00.000Z"}], "total": 1}}},
    {"let": {"anchored": {"kind": "extracted", "method": "ocr", "pdfClass": "C", "ocrConfidence": {"mean": 91.5, "lowConfidenceWords": 1, "totalWords": 6}, "unreadPages": [2], "text": "Ada Lovelace wrote the first program.", "items": [{"start": 0, "end": 19, "page": 1, "x": 72, "y": 700, "width": 190, "height": 12}, {"start": 19, "end": 37, "page": 1, "x": 72, "y": 680, "width": 180, "height": 12}]}}},
    {"backend": "content", "with": {"resource": {"$var": "r1"}, "mediaType": "image/png", "bytes": ""}},
    {"backend": "description", "with": {"resource": {"$var": "r1"}, "graph": {"$var": "graph"}}},
    {"backend": "annotations", "with": {"resource": {"$var": "r1"}, "annotations": {"$var": "annotations"}}},
    {"backend": "anchored-text", "with": {"resource": {"$var": "r1"}, "answer": {"$var": "anchored"}}},
    {"backend": "anchored-text", "with": {"resource": {"$var": "r3"}, "answer": {"kind": "not-yet"}}},
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},

    {"driver": "get", "with": {"resource": {"$var": "r1"}}, "returns": {"contentType": "image/png", "bytes": ""}},
    {"wire": "GET /resources/{id}", "status": 200, "token": {"$var": "token"}, "params": {"id": {"$var": "r1"}}},
    {"driver": "get-stream", "with": {"resource": {"$var": "r1"}}, "returns": {"contentType": "image/png", "bytes": ""}},
    {"wire": "GET /resources/{id}", "status": 200, "params": {"id": {"$var": "r1"}}},
    {"driver": "graph", "with": {"resource": {"$var": "r1"}}, "returns": {"$var": "graph"}},
    {"wire": "GET /resources/{id}/jsonld", "status": 200, "token": {"$var": "token"}, "params": {"id": {"$var": "r1"}}, "answer": {"$var": "graph"}},
    {"driver": "annotations", "with": {"resource": {"$var": "r1"}}, "returns": {"$var": "annotations"}},
    {"wire": "GET /resources/{id}/annotations", "status": 200, "token": {"$var": "token"}, "params": {"id": {"$var": "r1"}}, "answer": {"$var": "annotations"}},
    {"driver": "anchored-text", "with": {"resource": {"$var": "r1"}}, "returns": {"$var": "anchored"}},
    {"wire": "GET /resources/{id}/anchored-text", "status": 200, "token": {"$var": "token"}, "params": {"id": {"$var": "r1"}}, "answer": {"$var": "anchored"}},
    {"driver": "anchored-text", "with": {"resource": {"$var": "r3"}}, "returns": {"kind": "not-yet"}},
    {"wire": "GET /resources/{id}/anchored-text", "status": 200, "params": {"id": {"$var": "r3"}}, "answer": {"kind": "not-yet"}},

    {"driver": "get", "with": {"resource": {"$var": "r2"}}, "fails": {"code": "not-found", "status": 404}},
    {"wire": "GET /resources/{id}", "status": 404, "params": {"id": {"$var": "r2"}}},
    {"error": {"code": "not-found", "status": 404}},
    {"driver": "graph", "with": {"resource": {"$var": "r2"}}, "fails": {"code": "not-found", "status": 404}},
    {"wire": "GET /resources/{id}/jsonld", "status": 404, "params": {"id": {"$var": "r2"}}},
    {"error": {"code": "not-found", "status": 404}},
    {"driver": "annotations", "with": {"resource": {"$var": "r2"}}, "fails": {"code": "not-found", "status": 404}},
    {"wire": "GET /resources/{id}/annotations", "status": 404, "params": {"id": {"$var": "r2"}}},
    {"error": {"code": "not-found", "status": 404}},
    {"backend": "refuse", "with": {"wire": "GET /resources/{id}/anchored-text", "status": 404, "body": {"error": "Resource not found"}, "times": 1}},
    {"driver": "anchored-text", "with": {"resource": {"$var": "r2"}}, "fails": {"code": "not-found", "status": 404}},
    {"wire": "GET /resources/{id}/anchored-text", "status": 404, "params": {"id": {"$var": "r2"}}},
    {"error": {"code": "not-found", "status": 404}}
  ]
}
