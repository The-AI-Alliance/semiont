{
  "about": "a request is not sent before the stream that carries its reply is open: it waits for the stream, inside its own deadline",
  "source": "docs/protocol/TRANSPORT-HTTP.md § Connection lifecycle; specs/src/client/timing.json busRequestTimeoutMs",
  "steps": [
    {"let": {"response": {"resource": {"@context": "https://schema.org/", "@id": "https://kb.example/r", "name": "r", "representations": []}, "annotations": [], "entityReferences": []}}},
    {"backend": "listen", "with": {"channels": ["browse:resource-requested"]}},
    {"backend": "hold", "with": {"wire": "POST /bus/subscribe"}},
    {"driver": "open", "with": {"channels": ["browse:resource-failed", "browse:resource-result"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "at": "arrival", "body": {"clientId": {"$var": "clientId"}, "global": ["browse:resource-failed", "browse:resource-result"], "scoped": [], "pendingReplies": []}, "as": "stream"},

    {"driver": "request", "with": {"operation": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "timeoutMs": 10000}, "as": "asked"},
    {"quiet": 300},
    {"backend": "release"},
    {"state": "open"},
    {"wire": "POST /bus/emit", "status": 202, "follows": "stream", "body": {"channel": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "correlationId": {"$var": "cid"}, "clientId": {"$var": "clientId"}}},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "cid"}, "payload": {"response": {"$var": "response"}}}},
    {"settles": "asked", "returns": {"response": {"$var": "response"}}}
  ]
}
