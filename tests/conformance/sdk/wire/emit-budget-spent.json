{
  "about": "an emit refused by a limit on every attempt its budget allows fails as rate-limited, each attempt having waited the last refusal's Retry-After",
  "source": "docs/protocol/TRANSPORT-HTTP.md § Limits; specs/src/client/timing.json emitRetry",
  "planes": ["in-process"],
  "steps": [
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"backend": "refuse", "with": {"wire": "POST /bus/emit", "status": 429, "retryAfter": 1, "body": {"error": "The principal's emits have used its bucket", "code": "emit-rate"}, "times": 4}},

    {"driver": "emit", "with": {"channel": "beckon:focus", "payload": {"annotationId": "a-1"}}, "as": "emitted"},
    {"wire": "POST /bus/emit", "status": 429, "body": {"channel": "beckon:focus", "payload": {"annotationId": "a-1"}, "clientId": {"$var": "clientId"}}, "as": "first"},
    {"wire": "POST /bus/emit", "status": 429, "body": {"channel": "beckon:focus", "payload": {"annotationId": "a-1"}, "clientId": {"$var": "clientId"}}, "waited": "first", "as": "second"},
    {"wire": "POST /bus/emit", "status": 429, "body": {"channel": "beckon:focus", "payload": {"annotationId": "a-1"}, "clientId": {"$var": "clientId"}}, "waited": "second", "as": "third"},
    {"wire": "POST /bus/emit", "status": 429, "body": {"channel": "beckon:focus", "payload": {"annotationId": "a-1"}, "clientId": {"$var": "clientId"}}, "waited": "third"},
    {"settles": "emitted", "fails": {"code": "rate-limited", "status": 429}},
    {"error": {"code": "rate-limited", "status": 429}}
  ]
}
