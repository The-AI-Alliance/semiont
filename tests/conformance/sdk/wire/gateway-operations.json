{
  "about": "each gateway operation is one request to its own path, carrying the client's token, and resolves with what the gateway answered",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § Content and the gateway's own operations; specs/src/paths: api_health, api_status, api_users_me, api_tokens_media, well-known_oauth-protected-resource",
  "steps": [
    {"backend": "content", "with": {"resource": {"$var": "r1"}, "mediaType": "image/png", "bytes": ""}},
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},

    {"driver": "health", "returns": {"$var": "health"}},
    {"wire": "GET /api/health", "status": 200, "answer": {"$var": "health"}},
    {"driver": "status", "returns": {"$var": "status"}},
    {"wire": "GET /api/status", "status": 200, "token": {"$var": "token"}, "answer": {"$var": "status"}},
    {"driver": "current-user", "returns": {"$var": "user"}},
    {"wire": "GET /api/users/me", "status": 200, "token": {"$var": "token"}, "answer": {"$var": "user"}},
    {"driver": "protected-resource-metadata", "returns": {"$var": "metadata"}},
    {"wire": "GET /.well-known/oauth-protected-resource", "status": 200, "answer": {"$var": "metadata"}},
    {"driver": "media-token", "with": {"resource": {"$var": "r1"}}, "returns": {"$var": "media"}},
    {"wire": "POST /api/tokens/media", "status": 200, "token": {"$var": "token"}, "body": {"resourceId": {"$var": "r1"}}, "answer": {"$var": "media"}}
  ]
}
