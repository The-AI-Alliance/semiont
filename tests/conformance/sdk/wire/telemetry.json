{
  "about": "a client that exports sends the spans and the count the SDK telemetry table lists, each of its kind and carrying its attributes, and nothing else under their names",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § Telemetry; specs/src/sdk-telemetry/telemetry.json",
  "planes": ["in-process"],
  "telemetry": true,
  "steps": [
    {"let": {"graph": {"resource": {"@context": "https://schema.org/", "@id": "described", "name": "Described", "representations": []}, "annotations": [], "entityReferences": []}}},
    {"backend": "content", "with": {"resource": {"$var": "r1"}, "mediaType": "image/png", "bytes": ""}},
    {"backend": "description", "with": {"resource": {"$var": "r1"}, "graph": {"$var": "graph"}}},
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "at": "live", "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"driver": "listen", "with": {"channel": "beckon:focus"}},

    {"backend": "emit", "with": {"channel": "beckon:focus", "payload": {"annotationId": "a-1"}}},
    {"frame": "beckon:focus", "is": {"payload": {"$var": "_"}}},
    {"driver": "emit", "with": {"channel": "beckon:sparkle", "payload": {"annotationId": "a-2"}}},
    {"wire": "POST /bus/emit", "status": 202, "body": {"channel": "beckon:sparkle", "payload": {"annotationId": "a-2"}, "clientId": {"$var": "clientId"}}},

    {"driver": "put", "with": {"name": "Every byte", "format": "image/png", "storageUri": "file://uploads/telemetry.png", "bytes": ""}, "returns": {"resourceId": {"$var": "_"}}},
    {"wire": "POST /resources", "status": 202},
    {"driver": "get", "with": {"resource": {"$var": "r1"}}},
    {"wire": "GET /resources/{id}", "status": 200},
    {"driver": "get-stream", "with": {"resource": {"$var": "r1"}}},
    {"wire": "GET /resources/{id}", "status": 200},
    {"driver": "graph", "with": {"resource": {"$var": "r1"}}},
    {"wire": "GET /resources/{id}/jsonld", "status": 200}
  ]
}
