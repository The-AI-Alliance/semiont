    {"driver": "open", "with": {"channels": ["beckon:focus", "browse:resource-failed", "browse:resource-result"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "at": "live", "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus", "browse:resource-failed", "browse:resource-result"], "scoped": [], "pendingReplies": []}},
