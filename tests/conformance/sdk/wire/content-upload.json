{
  "about": "an upload carries its bytes unchanged with each field under its own name, and resolves with the id the gateway answers",
  "source": "docs/protocol/TRANSPORT-HTTP.md; specs/src/paths/resources.json",
  "steps": [
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},

    {"driver": "put", "with": {"name": "Every byte", "format": "image/png", "storageUri": "file://uploads/every-byte.png", "bytes": "", "language": "en", "entityTypes": ["Person", "Place"], "sourceResourceId": "res-source", "sourceAnnotationId": "ann-source", "generationPrompt": "a prompt", "jobId": "job-1", "isDraft": true}, "returns": {"resourceId": {"$var": "uploaded"}}},
    {"wire": "POST /resources", "status": 202, "token": {"$var": "token"}, "answer": {"resourceId": {"$var": "uploaded"}}},
    {"backend": "uploaded", "with": {"resource": {"$var": "uploaded"}, "bytes": "", "fields": {"name": "Every byte", "format": "image/png", "storageUri": "file://uploads/every-byte.png", "language": "en", "entityTypes": "[\"Person\",\"Place\"]", "sourceResourceId": "res-source", "sourceAnnotationId": "ann-source", "generationPrompt": "a prompt", "jobId": "job-1", "isDraft": "true"}}},

    {"driver": "get", "with": {"resource": {"$var": "uploaded"}}, "returns": {"contentType": "image/png", "bytes": ""}},
    {"wire": "GET /resources/{id}", "status": 200, "params": {"id": {"$var": "uploaded"}}}
  ]
}
