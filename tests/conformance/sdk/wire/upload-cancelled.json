{
  "about": "an upload its caller cancels before the gateway has answered reports nothing more: its connection is closed, nothing is put on the error stream, and it is not sent again",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § Content and the gateway's own operations",
  "steps": [
    {"backend": "hold", "with": {"wire": "POST /resources"}},
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"driver": "upload", "with": {"name": "Every byte", "format": "image/png", "storageUri": "file://uploads/cancelled.png", "bytes": ""}, "as": "sent"},
    {"wire": "POST /resources", "at": "arrival", "as": "held"},
    {"abandon": "sent"},
    {"settles": "sent", "abandoned": true},
    {"closed": "held"},
    {"quiet": 300}
  ]
}
