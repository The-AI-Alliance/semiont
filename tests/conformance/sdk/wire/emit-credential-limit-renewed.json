{
  "about": "an emit refused 429 refusal-rate is a refused credential, not a limit: it is sent again at once with the renewed token, not after Retry-After with the refused one, and settles with nothing reported",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § A refused credential; specs/src/components/schemas/LimitRefusal.json",
  "steps": [
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}, "renewals": [{"$var": "token2"}, "never-asked"]}},
    {"wire": "POST /bus/subscribe", "status": 200, "token": {"$var": "token"}, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"backend": "refuse", "with": {"wire": "POST /bus/emit", "status": 429, "retryAfter": 1, "body": {"error": "The requests this holder has had refused have used their allowance", "code": "refusal-rate"}, "times": 1}},
    {"driver": "emit", "with": {"channel": "beckon:focus", "payload": {}}, "as": "emitted"},
    {"wire": "POST /bus/emit", "status": 429, "token": {"$var": "token"}, "body": {"channel": "beckon:focus", "payload": {}, "clientId": {"$var": "clientId"}}},
    {"wire": "POST /bus/emit", "status": 202, "token": {"$var": "token2"}, "body": {"channel": "beckon:focus", "payload": {}, "clientId": {"$var": "clientId"}}},
    {"settles": "emitted"},
    {"quiet": 300}
  ]
}
