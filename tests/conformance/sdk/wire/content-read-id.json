{
  "about": "a resource's id is one segment of the path it is read at, whatever characters it has: the gateway is asked for that resource and no other",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § Content and the gateway's own operations; specs/src/paths/resources_{id}.json, resources_{id}_jsonld.json",
  "steps": [
    {"let": {"id": "what? 100% #1", "graph": {"resource": {"@context": "https://schema.org/", "@id": "https://kb.example/resources/what%3F%20100%25%20%231", "name": "Odd", "representations": []}, "annotations": [], "entityReferences": []}}},
    {"backend": "content", "with": {"resource": {"$var": "id"}, "mediaType": "text/plain", "bytes": "dGhlIG9kZCBvbmU="}},
    {"backend": "content", "with": {"resource": "what", "mediaType": "text/plain", "bytes": "dGhlIHdyb25nIG9uZQ=="}},
    {"backend": "description", "with": {"resource": {"$var": "id"}, "graph": {"$var": "graph"}}},
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},

    {"driver": "get", "with": {"resource": {"$var": "id"}}, "returns": {"contentType": "text/plain", "bytes": "dGhlIG9kZCBvbmU="}},
    {"wire": "GET /resources/{id}", "status": 200, "params": {"id": {"$var": "id"}}},
    {"driver": "get-stream", "with": {"resource": {"$var": "id"}}, "returns": {"contentType": "text/plain", "bytes": "dGhlIG9kZCBvbmU="}},
    {"wire": "GET /resources/{id}", "status": 200, "params": {"id": {"$var": "id"}}},
    {"driver": "graph", "with": {"resource": {"$var": "id"}}, "returns": {"$var": "graph"}},
    {"wire": "GET /resources/{id}/jsonld", "status": 200, "params": {"id": {"$var": "id"}}, "answer": {"$var": "graph"}}
  ]
}
