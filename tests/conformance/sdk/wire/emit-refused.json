    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}}},
    {"wire": "POST /bus/subscribe", "status": 200, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},

    {"driver": "emit", "with": {"channel": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "correlationId": {"$join": ["claim-", {"$var": "r1"}]}}},
    {"wire": "POST /bus/emit", "status": 202, "body": {"channel": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "correlationId": {"$join": ["claim-", {"$var": "r1"}]}, "clientId": {"$var": "clientId"}}},

    {"driver": "emit", "with": {"channel": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "correlationId": {"$join": ["claim-", {"$var": "r1"}]}}, "fails": {"code": "conflict", "status": 409}},
    {"wire": "POST /bus/emit", "status": 409, "body": {"channel": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "correlationId": {"$join": ["claim-", {"$var": "r1"}]}, "clientId": {"$var": "clientId"}}},
    {"error": {"code": "conflict", "status": 409}}
  ]
