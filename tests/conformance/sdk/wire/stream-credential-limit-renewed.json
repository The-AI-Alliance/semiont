{
  "about": "a stream refused 429 refusal-rate is a refused credential: it is reported as unauthorized with its 429, renewed, and opened with the token it is given",
  "source": "docs/protocol/TRANSPORT-CONTRACT.md § A refused credential; specs/src/components/schemas/LimitRefusal.json",
  "steps": [
    {"backend": "refuse", "with": {"wire": "POST /bus/subscribe", "status": 429, "retryAfter": 1, "body": {"error": "The requests this holder has had refused have used their allowance", "code": "refusal-rate"}, "times": 1}},
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50}, "renewals": [{"$var": "token2"}, "never-asked"]}},
    {"wire": "POST /bus/subscribe", "status": 429, "token": {"$var": "token"}, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"error": {"code": "unauthorized", "status": 429}},
    {"wire": "POST /bus/subscribe", "status": 200, "token": {"$var": "token2"}, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"quiet": 300}
  ]
}
