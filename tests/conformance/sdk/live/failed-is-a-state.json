{
  "about": "when the retry fails too, a key with no value is failed: a state its observers are given, on a stream that lives on; an observer arriving starts over, and every observer of the key is pending again, then ready (B15)",
  "source": "docs/protocol/CACHE-SEMANTICS.md B15",
  "tier": "fleet",
  "steps": [
    {"let": {"one": {"@context": "https://schema.org/", "@id": "one", "name": "one", "representations": []}}},
    {"backend": "listen", "with": {"channels": ["browse:resource-requested", "browse:annotations-requested", "browse:annotation-requested", "browse:events-requested", "browse:referenced-by-requested", "browse:resources-requested", "browse:entity-types-requested", "browse:tag-schemas-requested"]}},
    {"driver": "open", "with": {"timing": {"busRequestTimeoutMs": 5000, "invalidationWindowMs": 100, "reconnectMs": 50, "lazyRemoveMs": 50, "lingerMs": 50}}},
    {"state": "open"},

    {"observe": {"query": "resource", "resource": {"$var": "r1"}}, "as": "a"},
    {"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f1"},
    {"backend": "emit", "with": {"channel": "browse:resource-failed", "correlationId": {"$var": "f1"}, "payload": {"message": "it went wrong"}}},
    {"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f2"},
    {"backend": "emit", "with": {"channel": "browse:resource-failed", "correlationId": {"$var": "f2"}, "payload": {"message": "it went wrong"}}},
    {"reaches": "a", "state": {"status": "failed", "error": {"code": "bus.rejected"}}},
    {"quiet": 300},

    {"observe": {"query": "resource", "resource": {"$var": "r1"}}, "as": "b"},
    {"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f3"},
    {"holds": "a", "state": {"status": "pending"}},
    {"holds": "b", "state": {"status": "pending"}},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "f3"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"reaches": "a", "state": {"status": "ready", "value": {"$var": "one"}}},
    {"reaches": "b", "state": {"status": "ready", "value": {"$var": "one"}}},
    {"quiet": 300}
  ]
}
