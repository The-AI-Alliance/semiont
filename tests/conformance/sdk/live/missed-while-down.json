{
  "about": "what every client hears is lost while the stream is down, so a client whose stream reopens after a drop asks again for what those events feed and it holds: its lists of resources, the resources themselves, the entity types and the tag schemas. What a scope's own events feed it does not ask for, and a stream handed over for a changed subscription costs no request at all (B13)",
  "source": "docs/protocol/CACHE-SEMANTICS.md B13; specs/src/client/refresh.json reopened",
  "tier": "parity",
  "steps": [
    {"let": {"one": {"@context": "https://schema.org/", "@id": "one", "name": "one", "representations": []}, "two": {"@context": "https://schema.org/", "@id": "two", "name": "two", "representations": []}}},
    {"backend": "listen", "with": {"channels": ["browse:resource-requested", "browse:annotations-requested", "browse:annotation-requested", "browse:events-requested", "gather:referenced-by-requested", "browse:resources-requested", "browse:entity-types-requested", "browse:tag-schemas-requested"]}},
    {"driver": "open", "with": {"timing": {"busRequestTimeoutMs": 5000, "invalidationWindowMs": 100, "reconnectMs": 50, "lazyRemoveMs": 50, "lingerMs": 50}}},
    {"state": "open"},

    {"observe": {"query": "resources"}, "as": "list"},
    {"fetch": "browse:resources-requested", "payload": {"limit": 100, "offset": 0}, "as": "f1"},
    {"backend": "emit", "with": {"channel": "browse:resources-result", "correlationId": {"$var": "f1"}, "payload": {"response": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}}},
    {"reaches": "list", "state": {"status": "ready", "value": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}},
    {"observe": {"query": "entityTypes"}, "as": "types"},
    {"fetch": "browse:entity-types-requested", "as": "f2"},
    {"backend": "emit", "with": {"channel": "browse:entity-types-result", "correlationId": {"$var": "f2"}, "payload": {"response": {"entityTypes": ["Person"]}}}},
    {"reaches": "types", "state": {"status": "ready", "value": ["Person"]}},
    {"observe": {"query": "tagSchemas"}, "as": "schemas"},
    {"fetch": "browse:tag-schemas-requested", "as": "f3"},
    {"backend": "emit", "with": {"channel": "browse:tag-schemas-result", "correlationId": {"$var": "f3"}, "payload": {"response": {"tagSchemas": []}}}},
    {"reaches": "schemas", "state": {"status": "ready", "value": []}},
    {"observe": {"query": "resource", "resource": {"$var": "r1"}}, "as": "res"},
    {"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f4"},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "f4"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"reaches": "res", "state": {"status": "ready", "value": {"$var": "one"}}},
    {"observe": {"query": "annotations", "resource": {"$var": "r1"}}, "as": "marks"},
    {"fetch": "browse:annotations-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f5"},
    {"backend": "emit", "with": {"channel": "browse:annotations-result", "correlationId": {"$var": "f5"}, "payload": {"response": {"annotations": [], "total": 0}}}},
    {"reaches": "marks", "state": {"status": "ready", "value": []}},
    {"scopes": [{"$var": "r1"}]},

    {"backend": "down"},
    {"state": "reconnecting"},
    {"backend": "record", "with": {"resource": {"$var": "r2"}, "channel": "yield:created", "sequence": 1, "live": true, "unscoped": true}},
    {"backend": "record", "with": {"resource": {"$var": "r2"}, "channel": "frame:entity-type-added", "sequence": 2, "live": true, "unscoped": true}},
    {"backend": "up"},
    {"state": "open"},
    {"fetches": [{"fetch": "browse:resources-requested", "payload": {"limit": 100, "offset": 0}, "as": "g1"}, {"fetch": "browse:entity-types-requested", "as": "g2"}, {"fetch": "browse:tag-schemas-requested", "as": "g3"}, {"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "g4"}]},
    {"backend": "emit", "with": {"channel": "browse:resources-result", "correlationId": {"$var": "g1"}, "payload": {"response": {"resources": [{"$var": "two"}], "total": 1, "offset": 0, "limit": 100, "matchKind": "lexical"}}}},
    {"backend": "emit", "with": {"channel": "browse:entity-types-result", "correlationId": {"$var": "g2"}, "payload": {"response": {"entityTypes": ["Person", "Place"]}}}},
    {"backend": "emit", "with": {"channel": "browse:tag-schemas-result", "correlationId": {"$var": "g3"}, "payload": {"response": {"tagSchemas": []}}}},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "g4"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"reaches": "list", "state": {"status": "ready", "value": {"resources": [{"$var": "two"}], "total": 1, "offset": 0, "limit": 100, "matchKind": "lexical"}}},
    {"reaches": "types", "state": {"status": "ready", "value": ["Person", "Place"]}},
    {"scopes": [{"$var": "r1"}]},
    {"quiet": 400},

    {"observe": {"query": "annotations", "resource": {"$var": "r2"}}, "as": "others"},
    {"fetch": "browse:annotations-requested", "payload": {"resourceId": {"$var": "r2"}}, "as": "h1"},
    {"backend": "emit", "with": {"channel": "browse:annotations-result", "correlationId": {"$var": "h1"}, "payload": {"response": {"annotations": [], "total": 0}}}},
    {"reaches": "others", "state": {"status": "ready", "value": []}},
    {"scopes": [{"$var": "r1"}, {"$var": "r2"}]},
    {"quiet": 400},
    {"holds": "marks", "state": {"status": "ready", "value": []}}
  ]
}
