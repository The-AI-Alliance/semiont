{
  "about": "a refresh that fails, and fails again on its one retry, leaves the observer holding the value it had: a key with a value is never failed (B6, B14)",
  "source": "docs/protocol/CACHE-SEMANTICS.md B6, B14",
  "tier": "parity",
  "steps": [
    {"backend": "listen", "with": {"channels": ["browse:resource-requested", "browse:annotations-requested", "browse:annotation-requested", "browse:events-requested", "gather:referenced-by-requested", "browse:resources-requested", "browse:entity-types-requested", "browse:tag-schemas-requested"]}},
    {"driver": "open", "with": {"timing": {"busRequestTimeoutMs": 5000, "invalidationWindowMs": 100, "reconnectMs": 50, "lazyRemoveMs": 50, "lingerMs": 50}}},
    {"state": "open"},

    {"observe": {"query": "annotations", "resource": {"$var": "r1"}}, "as": "a"},
    {"fetch": "browse:annotations-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f1"},
    {"backend": "emit", "with": {"channel": "browse:annotations-result", "correlationId": {"$var": "f1"}, "payload": {"response": {"annotations": [], "total": 0}}}},
    {"reaches": "a", "state": {"status": "ready", "value": []}},
    {"scopes": [{"$var": "r1"}]},
    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "mark:added", "sequence": 1, "live": true}},
    {"fetch": "browse:annotations-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f2"},
    {"backend": "emit", "with": {"channel": "browse:annotations-failed", "correlationId": {"$var": "f2"}, "payload": {"message": "it went wrong"}}},
    {"fetch": "browse:annotations-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f3"},
    {"backend": "emit", "with": {"channel": "browse:annotations-failed", "correlationId": {"$var": "f3"}, "payload": {"message": "it went wrong"}}},
    {"quiet": 300},
    {"holds": "a", "state": {"status": "ready", "value": []}}
  ]
}
