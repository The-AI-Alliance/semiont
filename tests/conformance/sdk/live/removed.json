{
  "about": "an event saying an annotation is gone ends it: its observer is told it is not found, with no request made; an observer arriving later asks, and the service tells every observer the same (B13a)",
  "source": "packages/sdk/docs/CACHE-SEMANTICS.md B13a; specs/src/client/refresh.json mark:removed",
  "tier": "parity",
  "steps": [
    {"backend": "listen", "with": {"channels": ["browse:resource-requested", "browse:annotations-requested", "browse:annotation-requested", "browse:events-requested", "browse:referenced-by-requested", "browse:resources-requested", "browse:entity-types-requested", "browse:tag-schemas-requested"]}},
    {"driver": "open", "with": {"timing": {"busRequestTimeoutMs": 5000, "invalidationWindowMs": 100, "reconnectMs": 50, "lazyRemoveMs": 50, "lingerMs": 50}}},
    {"state": "open"},

    {"observe": {"query": "annotation", "resource": {"$var": "r1"}, "annotation": {"$var": "a1"}}, "as": "a"},
    {"fetch": "browse:annotation-requested", "payload": {"resourceId": {"$var": "r1"}, "annotationId": {"$var": "a1"}}, "as": "d1"},
    {"backend": "emit", "with": {"channel": "browse:annotation-result", "correlationId": {"$var": "d1"}, "payload": {"response": {"annotation": {"@context": "http://www.w3.org/ns/anno.jsonld", "type": "Annotation", "id": {"$var": "a1"}, "motivation": "highlighting", "target": {"source": {"$var": "r1"}}, "created": "2026-01-01T00:00:00.000Z"}, "resource": null, "resolvedResource": null}}}},
    {"reaches": "a", "state": {"status": "ready", "value": {"@context": "http://www.w3.org/ns/anno.jsonld", "type": "Annotation", "id": {"$var": "a1"}, "motivation": "highlighting", "target": {"source": {"$var": "r1"}}, "created": "2026-01-01T00:00:00.000Z"}}},
    {"scopes": [{"$var": "r1"}]},
    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "mark:removed", "sequence": 1, "live": true, "payload": {"annotationId": {"$var": "a1"}}}},
    {"reaches": "a", "state": {"status": "failed", "error": {"code": "bus.not-found"}}},
    {"quiet": 300},

    {"observe": {"query": "annotation", "resource": {"$var": "r1"}, "annotation": {"$var": "a1"}}, "as": "b"},
    {"reaches": "a", "state": {"status": "pending"}},
    {"fetch": "browse:annotation-requested", "payload": {"resourceId": {"$var": "r1"}, "annotationId": {"$var": "a1"}}, "as": "d2"},
    {"backend": "emit", "with": {"channel": "browse:annotation-failed", "correlationId": {"$var": "d2"}, "payload": {"message": "no such annotation", "code": "not-found"}}},
    {"fetch": "browse:annotation-requested", "payload": {"resourceId": {"$var": "r1"}, "annotationId": {"$var": "a1"}}, "as": "d3"},
    {"backend": "emit", "with": {"channel": "browse:annotation-failed", "correlationId": {"$var": "d3"}, "payload": {"message": "no such annotation", "code": "not-found"}}},
    {"reaches": "a", "state": {"status": "failed", "error": {"code": "bus.not-found"}}},
    {"reaches": "b", "state": {"status": "failed", "error": {"code": "bus.not-found"}}},
    {"quiet": 300}
  ]
}
