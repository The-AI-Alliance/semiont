{
  "about": "a resource created, updated, cloned, moved, archived or unarchived refreshes that resource, when the client holds it, and every list of resources the client holds, and nothing else",
  "source": "packages/sdk/docs/CACHE-SEMANTICS.md § Mapping: bus events → cache invalidations (yield:created, yield:updated, yield:cloned, yield:moved, mark:archived, mark:unarchived)",
  "tier": "parity",
  "steps": [
    {"let": {"one": {"@context": "https://schema.org/", "@id": "https://kb.example/resources/one", "name": "one", "representations": []}}},
    {"backend": "listen", "with": {"channels": ["browse:resource-requested", "browse:annotations-requested", "browse:annotation-requested", "browse:events-requested", "browse:referenced-by-requested", "browse:resources-requested", "browse:entity-types-requested", "browse:tag-schemas-requested"]}},
    {"driver": "open", "with": {"timing": {"busRequestTimeoutMs": 5000, "invalidationWindowMs": 100, "reconnectMs": 50, "lazyRemoveMs": 50, "lingerMs": 50}}},
    {"state": "open"},

    {"observe": {"query": "annotations", "resource": {"$var": "r1"}}, "as": "a"},
    {"fetch": "browse:annotations-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f1"},
    {"backend": "emit", "with": {"channel": "browse:annotations-result", "correlationId": {"$var": "f1"}, "payload": {"response": {"annotations": [], "total": 0}}}},
    {"reaches": "a", "state": {"status": "ready", "value": []}},
    {"observe": {"query": "events", "resource": {"$var": "r1"}}, "as": "b"},
    {"fetch": "browse:events-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f2"},
    {"backend": "emit", "with": {"channel": "browse:events-result", "correlationId": {"$var": "f2"}, "payload": {"response": {"events": [], "total": 0, "resourceId": {"$var": "r1"}}}}},
    {"reaches": "b", "state": {"status": "ready", "value": []}},
    {"observe": {"query": "resource", "resource": {"$var": "r1"}}, "as": "c"},
    {"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f3"},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "f3"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"reaches": "c", "state": {"status": "ready", "value": {"$var": "one"}}},
    {"observe": {"query": "resources"}, "as": "d"},
    {"fetch": "browse:resources-requested", "payload": {"limit": 100, "offset": 0}, "as": "f4"},
    {"backend": "emit", "with": {"channel": "browse:resources-result", "correlationId": {"$var": "f4"}, "payload": {"response": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}}},
    {"reaches": "d", "state": {"status": "ready", "value": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}},
    {"scopes": [{"$var": "r1"}]},

    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "yield:updated", "sequence": 1, "live": true, "unscoped": true}},
    {"fetches": [{"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "g1"}, {"fetch": "browse:resources-requested", "payload": {"limit": 100, "offset": 0}, "as": "g2"}]},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "g1"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"backend": "emit", "with": {"channel": "browse:resources-result", "correlationId": {"$var": "g2"}, "payload": {"response": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}}},
    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "yield:moved", "sequence": 2, "live": true, "unscoped": true}},
    {"fetches": [{"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "h1"}, {"fetch": "browse:resources-requested", "payload": {"limit": 100, "offset": 0}, "as": "h2"}]},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "h1"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"backend": "emit", "with": {"channel": "browse:resources-result", "correlationId": {"$var": "h2"}, "payload": {"response": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}}},
    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "yield:cloned", "sequence": 3, "live": true, "unscoped": true}},
    {"fetches": [{"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "i1"}, {"fetch": "browse:resources-requested", "payload": {"limit": 100, "offset": 0}, "as": "i2"}]},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "i1"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"backend": "emit", "with": {"channel": "browse:resources-result", "correlationId": {"$var": "i2"}, "payload": {"response": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}}},
    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "mark:archived", "sequence": 4, "live": true}},
    {"fetches": [{"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "j1"}, {"fetch": "browse:resources-requested", "payload": {"limit": 100, "offset": 0}, "as": "j2"}]},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "j1"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"backend": "emit", "with": {"channel": "browse:resources-result", "correlationId": {"$var": "j2"}, "payload": {"response": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}}},
    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "mark:unarchived", "sequence": 5, "live": true}},
    {"fetches": [{"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "k1"}, {"fetch": "browse:resources-requested", "payload": {"limit": 100, "offset": 0}, "as": "k2"}]},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "k1"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"backend": "emit", "with": {"channel": "browse:resources-result", "correlationId": {"$var": "k2"}, "payload": {"response": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}}},

    {"backend": "record", "with": {"resource": {"$var": "r2"}, "channel": "yield:created", "sequence": 1, "live": true, "unscoped": true}},
    {"fetch": "browse:resources-requested", "payload": {"limit": 100, "offset": 0}, "as": "m1"},
    {"backend": "emit", "with": {"channel": "browse:resources-result", "correlationId": {"$var": "m1"}, "payload": {"response": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}}},
    {"quiet": 400}
  ]
}
