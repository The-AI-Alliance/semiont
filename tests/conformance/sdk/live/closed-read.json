{
  "about": "a one-shot read of a closed client fails as a request of a closed bus does, with no request made (B16)",
  "source": "docs/protocol/CACHE-SEMANTICS.md B16; specs/src/errors/codes.json bus.closed",
  "tier": "parity",
  "steps": [
    {"backend": "listen", "with": {"channels": ["browse:resource-requested", "browse:annotations-requested", "browse:annotation-requested", "browse:events-requested", "gather:referenced-by-requested", "browse:resources-requested", "browse:entity-types-requested", "browse:tag-schemas-requested"]}},
    {"driver": "open", "with": {"timing": {"busRequestTimeoutMs": 5000, "invalidationWindowMs": 100, "reconnectMs": 50, "lazyRemoveMs": 50, "lingerMs": 50}}},
    {"state": "open"},

    {"driver": "close"},
    {"driver": "fresh", "with": {"query": {"query": "resource", "resource": {"$var": "r1"}}}, "fails": {"code": "bus.closed"}},
    {"driver": "fresh", "with": {"query": {"query": "entityTypes"}}, "fails": {"code": "bus.closed"}},
    {"quiet": 300}
  ]
