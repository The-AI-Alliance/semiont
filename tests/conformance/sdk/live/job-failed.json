{
  "about": "a job's failure reaches the client that follows it as a frame: one the queue will try again is a setback the follower reports and follows past, and it does not ask for the status of the attempt that died however long the next takes to begin; one that is final ends the follower as failed, under the code every SDK reports it by",
  "source": "docs/protocol/JOBS.md § Following a job; specs/src/client/timing.json jobSilenceMs; specs/src/errors/codes.json job",
  "tier": "parity",
  "steps": [
    {
      "backend": "listen",
      "with": {
        "channels": [
          "job:create",
          "job:status-requested"
        ]
      }
    },
    {
      "driver": "open",
      "with": {
        "timing": {
          "busRequestTimeoutMs": 5000,
          "invalidationWindowMs": 100,
          "reconnectMs": 50,
          "lazyRemoveMs": 50,
          "lingerMs": 50,
          "jobSilenceMs": 1000,
          "jobStatusPollMs": 60000
        }
      }
    },
    {
      "state": "open"
    },
    {
      "driver": "markDelegate",
      "with": {
        "observer": "job",
        "resource": {
          "$var": "r1"
        },
        "params": {
          "motivation": "highlighting"
        }
      }
    },
    {
      "fetch": "job:create",
      "payload": {
        "jobType": "mark",
        "resourceId": {
          "$var": "r1"
        },
        "params": {
          "motivation": "highlighting"
        }
      },
      "as": "c1"
    },
    {
      "backend": "emit",
      "with": {
        "channel": "job:created",
        "correlationId": {
          "$var": "c1"
        },
        "payload": {
          "response": {
            "jobId": "job-1"
          }
        }
      }
    },
    {
      "backend": "emit",
      "with": {
        "channel": "job:fail",
        "payload": {
          "resourceId": {
            "$var": "r1"
          },
          "jobId": "job-1",
          "jobType": "mark",
          "attempt": 1,
          "error": "the model did not answer",
          "willRetry": true
        }
      }
    },
    {
      "reaches": "job",
      "state": {
        "status": "ready",
        "value": {
          "kind": "failed",
          "data": {
            "_userId": {
              "$var": "_"
            },
            "resourceId": {
              "$var": "r1"
            },
            "jobId": "job-1",
            "jobType": "mark",
            "attempt": 1,
            "error": "the model did not answer",
            "willRetry": true
          }
        }
      }
    },
    {
      "quiet": 2000
    },
    {
      "backend": "emit",
      "with": {
        "channel": "job:fail",
        "payload": {
          "resourceId": {
            "$var": "r1"
          },
          "jobId": "job-1",
          "jobType": "mark",
          "attempt": 2,
          "error": "the model did not answer",
          "willRetry": false
        }
      }
    },
    {
      "reaches": "job",
      "state": {
        "status": "failed",
        "error": {
          "code": "job.failed"
        }
      }
    },
    {
      "quiet": 300
    }
  ]
}
