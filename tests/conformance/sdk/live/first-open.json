{
  "about": "observers that arrive before the stream has first opened wait for it, and cost one request each when it does: the first open is not a reopening, and nothing is asked for twice (B13)",
  "source": "packages/sdk/docs/CACHE-SEMANTICS.md B13; specs/src/client/refresh.json reopened",
  "tier": "parity",
  "steps": [
    {"backend": "listen", "with": {"channels": ["browse:resource-requested", "browse:resources-requested", "browse:entity-types-requested"]}},
    {"backend": "hold", "with": {"wire": "POST /bus/subscribe"}},
    {"driver": "open", "with": {"timing": {"busRequestTimeoutMs": 5000, "invalidationWindowMs": 100, "reconnectMs": 50, "lazyRemoveMs": 50, "lingerMs": 50}}},

    {"observe": {"query": "resources"}, "as": "list"},
    {"observe": {"query": "entityTypes"}, "as": "types"},
    {"holds": "list", "state": {"status": "pending"}},
    {"backend": "release"},
    {"state": "open"},
    {"fetches": [{"fetch": "browse:resources-requested", "payload": {"limit": 100, "offset": 0}, "as": "f1"}, {"fetch": "browse:entity-types-requested", "as": "f2"}]},
    {"backend": "emit", "with": {"channel": "browse:resources-result", "correlationId": {"$var": "f1"}, "payload": {"response": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}}},
    {"backend": "emit", "with": {"channel": "browse:entity-types-result", "correlationId": {"$var": "f2"}, "payload": {"response": {"entityTypes": ["Person"]}}}},
    {"reaches": "list", "state": {"status": "ready", "value": {"resources": [], "total": 0, "offset": 0, "limit": 100, "matchKind": "lexical"}}},
    {"reaches": "types", "state": {"status": "ready", "value": ["Person"]}},
    {"quiet": 400}
  ]
}
