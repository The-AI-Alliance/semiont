{
  "about": "an entity type or a tag schema added to the knowledge base refreshes that vocabulary, and nothing else the client holds",
  "source": "packages/sdk/docs/CACHE-SEMANTICS.md § Mapping: bus events → cache invalidations (frame:entity-type-added, frame:tag-schema-added)",
  "tier": "parity",
  "steps": [
    {"let": {"one": {"@context": "https://schema.org/", "@id": "https://kb.example/resources/one", "name": "one", "representations": []}}},
    {"backend": "listen", "with": {"channels": ["browse:resource-requested", "browse:annotations-requested", "browse:annotation-requested", "browse:events-requested", "browse:referenced-by-requested", "browse:resources-requested", "browse:entity-types-requested", "browse:tag-schemas-requested"]}},
    {"driver": "open", "with": {"timing": {"busRequestTimeoutMs": 5000, "invalidationWindowMs": 100, "reconnectMs": 50, "lazyRemoveMs": 50, "lingerMs": 50}}},
    {"state": "open"},

    {"observe": {"query": "entityTypes"}, "as": "a"},
    {"fetch": "browse:entity-types-requested", "as": "f1"},
    {"backend": "emit", "with": {"channel": "browse:entity-types-result", "correlationId": {"$var": "f1"}, "payload": {"response": {"entityTypes": ["Person"]}}}},
    {"reaches": "a", "state": {"status": "ready", "value": ["Person"]}},
    {"observe": {"query": "tagSchemas"}, "as": "b"},
    {"fetch": "browse:tag-schemas-requested", "as": "f2"},
    {"backend": "emit", "with": {"channel": "browse:tag-schemas-result", "correlationId": {"$var": "f2"}, "payload": {"response": {"tagSchemas": []}}}},
    {"reaches": "b", "state": {"status": "ready", "value": []}},
    {"observe": {"query": "resource", "resource": {"$var": "r1"}}, "as": "c"},
    {"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f3"},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "f3"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"reaches": "c", "state": {"status": "ready", "value": {"$var": "one"}}},
    {"scopes": [{"$var": "r1"}]},

    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "frame:entity-type-added", "sequence": 1, "live": true, "unscoped": true}},
    {"fetch": "browse:entity-types-requested", "as": "g1"},
    {"backend": "emit", "with": {"channel": "browse:entity-types-result", "correlationId": {"$var": "g1"}, "payload": {"response": {"entityTypes": ["Person", "Place"]}}}},
    {"reaches": "a", "state": {"status": "ready", "value": ["Person", "Place"]}},

    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "frame:tag-schema-added", "sequence": 2, "live": true, "unscoped": true}},
    {"fetch": "browse:tag-schemas-requested", "as": "h1"},
    {"backend": "emit", "with": {"channel": "browse:tag-schemas-result", "correlationId": {"$var": "h1"}, "payload": {"response": {"tagSchemas": []}}}},
    {"quiet": 400}
  ]
}
