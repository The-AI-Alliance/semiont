{
  "about": "when the gateway says it could not cover what a scope missed, the client asks again for what it holds of that resource and for the vocabularies it holds, and for nothing else (B13)",
  "source": "packages/sdk/docs/CACHE-SEMANTICS.md B13",
  "tier": "parity",
  "steps": [
    {"let": {"one": {"@context": "https://schema.org/", "@id": "https://kb.example/resources/one", "name": "one", "representations": []}, "two": {"@context": "https://schema.org/", "@id": "https://kb.example/resources/two", "name": "two", "representations": []}}},
    {"backend": "listen", "with": {"channels": ["browse:resource-requested", "browse:annotations-requested", "browse:annotation-requested", "browse:events-requested", "browse:referenced-by-requested", "browse:resources-requested", "browse:entity-types-requested", "browse:tag-schemas-requested"]}},
    {"driver": "open", "with": {"timing": {"busRequestTimeoutMs": 5000, "invalidationWindowMs": 100, "reconnectMs": 50, "lazyRemoveMs": 50, "lingerMs": 50}}},
    {"state": "open"},

    {"observe": {"query": "annotations", "resource": {"$var": "r1"}}, "as": "a"},
    {"fetch": "browse:annotations-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f1"},
    {"backend": "emit", "with": {"channel": "browse:annotations-result", "correlationId": {"$var": "f1"}, "payload": {"response": {"annotations": [], "total": 0}}}},
    {"reaches": "a", "state": {"status": "ready", "value": []}},
    {"observe": {"query": "resource", "resource": {"$var": "r1"}}, "as": "b"},
    {"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f2"},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "f2"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"reaches": "b", "state": {"status": "ready", "value": {"$var": "one"}}},
    {"observe": {"query": "entityTypes"}, "as": "c"},
    {"fetch": "browse:entity-types-requested", "as": "f3"},
    {"backend": "emit", "with": {"channel": "browse:entity-types-result", "correlationId": {"$var": "f3"}, "payload": {"response": {"entityTypes": ["Person"]}}}},
    {"reaches": "c", "state": {"status": "ready", "value": ["Person"]}},
    {"observe": {"query": "resource", "resource": {"$var": "r2"}}, "as": "d"},
    {"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r2"}}, "as": "f4"},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "f4"}, "payload": {"response": {"resource": {"$var": "two"}, "annotations": [], "entityReferences": []}}}},
    {"reaches": "d", "state": {"status": "ready", "value": {"$var": "two"}}},
    {"scopes": [{"$var": "r1"}, {"$var": "r2"}]},

    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "mark:added", "sequence": 1, "live": true}},
    {"fetch": "browse:annotations-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "f5"},
    {"backend": "emit", "with": {"channel": "browse:annotations-result", "correlationId": {"$var": "f5"}, "payload": {"response": {"annotations": [], "total": 0}}}},
    {"backend": "archivist", "with": {"replayFails": true}},
    {"backend": "cut"},
    {"state": "reconnecting"},
    {"fetches": [{"fetch": "browse:annotations-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "g1"}, {"fetch": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "as": "g2"}, {"fetch": "browse:entity-types-requested", "as": "g3"}]},
    {"backend": "archivist", "with": {"replayFails": false}},
    {"backend": "emit", "with": {"channel": "browse:annotations-result", "correlationId": {"$var": "g1"}, "payload": {"response": {"annotations": [{"@context": "http://www.w3.org/ns/anno.jsonld", "type": "Annotation", "id": {"$var": "a1"}, "motivation": "highlighting", "target": {"source": {"$var": "r1"}}, "created": "2026-01-01T00:00:00.000Z"}], "total": 1}}}},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "g2"}, "payload": {"response": {"resource": {"$var": "one"}, "annotations": [], "entityReferences": []}}}},
    {"backend": "emit", "with": {"channel": "browse:entity-types-result", "correlationId": {"$var": "g3"}, "payload": {"response": {"entityTypes": ["Person", "Place"]}}}},
    {"reaches": "a", "state": {"status": "ready", "value": [{"@context": "http://www.w3.org/ns/anno.jsonld", "type": "Annotation", "id": {"$var": "a1"}, "motivation": "highlighting", "target": {"source": {"$var": "r1"}}, "created": "2026-01-01T00:00:00.000Z"}]}},
    {"reaches": "c", "state": {"status": "ready", "value": ["Person", "Place"]}},
    {"quiet": 300}
  ]
}
