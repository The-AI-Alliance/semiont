{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "An SDK conformance case",
  "description": "One scenario every SDK is put through: what the client is asked to do, what the backend does around it, and the transcript a conforming client produces. README.md explains each step.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "about",
    "source",
    "steps"
  ],
  "properties": {
    "about": {
      "type": "string",
      "minLength": 1,
      "description": "What the case holds a client to, in a sentence."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Where the protocol or the spec states it."
    },
    "planes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "in-process",
          "nats"
        ]
      },
      "description": "The signal planes the case runs on. Absent, it runs on both."
    },
    "tier": {
      "enum": [
        "fleet",
        "parity"
      ],
      "description": "A live case's tier: `fleet`, what every SDK with a live layer does, or `parity`, what one that implements all of CACHE-SEMANTICS does."
    },
    "telemetry": {
      "const": true,
      "description": "Run the client exporting to an OTLP receiver, and once it has exited hold what it exported to specs/src/sdk-telemetry/telemetry.json."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "step": {
      "oneOf": [
        {
          "description": "Name values for later steps.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "let"
          ],
          "properties": {
            "let": {
              "type": "object",
              "minProperties": 1
            }
          }
        },
        {
          "description": "Ask the driver for an operation. It must succeed, with `returns` when given, or fail with `fails`. With `as`, the step does not wait: a later `settles` step does.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "driver"
          ],
          "not": {
            "required": [
              "returns",
              "fails"
            ]
          },
          "properties": {
            "driver": {
              "type": "string"
            },
            "with": {
              "type": "object"
            },
            "returns": {},
            "fails": {},
            "as": {
              "$ref": "#/definitions/name"
            }
          }
        },
        {
          "description": "Abandon an operation started with `as`, as its caller would.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "abandon"
          ],
          "properties": {
            "abandon": {
              "$ref": "#/definitions/name"
            }
          }
        },
        {
          "description": "An operation started with `as` settles: it succeeded, with `returns` when given; or failed with `fails`; or, `abandoned`, it ended because the case abandoned it and reported nothing.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "settles"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "returns",
                  "fails"
                ]
              },
              {
                "required": [
                  "returns",
                  "abandoned"
                ]
              },
              {
                "required": [
                  "fails",
                  "abandoned"
                ]
              }
            ]
          },
          "properties": {
            "settles": {
              "$ref": "#/definitions/name"
            },
            "returns": {},
            "fails": {},
            "abandoned": {
              "const": true
            }
          }
        },
        {
          "description": "The next request the client put on the wire is this operation, with each field given.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wire"
          ],
          "properties": {
            "wire": {
              "type": "string",
              "pattern": "^(GET|POST|PUT|DELETE|PATCH) /"
            },
            "at": {
              "enum": [
                "arrival",
                "answer",
                "live"
              ]
            },
            "status": {
              "type": "integer"
            },
            "params": {
              "type": "object"
            },
            "body": {},
            "token": {},
            "answer": {},
            "as": {
              "$ref": "#/definitions/name"
            },
            "follows": {
              "$ref": "#/definitions/name"
            },
            "waited": {
              "$ref": "#/definitions/name"
            }
          }
        },
        {
          "description": "The stream a wire step named has carried this frame to the client.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "carried",
            "is"
          ],
          "properties": {
            "carried": {
              "$ref": "#/definitions/name"
            },
            "is": {}
          }
        },
        {
          "description": "The request a `wire` step named has ended with no answer: the client closed it.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "closed"
          ],
          "properties": {
            "closed": {
              "$ref": "#/definitions/name"
            }
          }
        },
        {
          "description": "An upload started with `as`, and not yet settled, has reported all of it sent: every report states the same total, none states less than the one before, and the last states the total.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "progress"
          ],
          "properties": {
            "progress": {
              "$ref": "#/definitions/name"
            }
          }
        },
        {
          "description": "The transport comes to report this state.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "initial",
                "connecting",
                "open",
                "reconnecting",
                "degraded",
                "unauthenticated",
                "closed"
              ]
            }
          }
        },
        {
          "description": "The transport is in this state and has reported no other since the case last read its state.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stays"
          ],
          "properties": {
            "stays": {
              "enum": [
                "initial",
                "connecting",
                "open",
                "reconnecting",
                "degraded",
                "unauthenticated",
                "closed"
              ]
            }
          }
        },
        {
          "description": "The next frame the client delivers on this channel is this one.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame",
            "is"
          ],
          "properties": {
            "frame": {
              "type": "string"
            },
            "is": {}
          }
        },
        {
          "description": "The client delivers this many more frames on this channel. What they are is held, as every frame is, to what the gateway sent.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frames",
            "count"
          ],
          "properties": {
            "frames": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "description": "The next failure on the client's error stream is this one.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error"
          ],
          "properties": {
            "error": {}
          }
        },
        {
          "description": "The backend does something.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend"
          ],
          "properties": {
            "backend": {
              "enum": [
                "listen",
                "emit",
                "record",
                "content",
                "description",
                "uploaded",
                "refuse",
                "hold",
                "release",
                "rechunk",
                "cut",
                "down",
                "up",
                "archivist"
              ]
            },
            "with": {
              "type": "object"
            }
          }
        },
        {
          "description": "The client puts nothing more on the wire for this many milliseconds.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quiet"
          ],
          "properties": {
            "quiet": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "description": "Live: an observer, named by `as`, begins observing a live query.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observe",
            "as"
          ],
          "properties": {
            "observe": {
              "type": "object",
              "required": [
                "query"
              ]
            },
            "as": {
              "$ref": "#/definitions/name"
            }
          }
        },
        {
          "description": "Live: the observer stops observing.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "leave"
          ],
          "properties": {
            "leave": {
              "$ref": "#/definitions/name"
            }
          }
        },
        {
          "description": "Live: the observer comes to hold this state.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reaches",
            "state"
          ],
          "properties": {
            "reaches": {
              "$ref": "#/definitions/name"
            },
            "state": {}
          }
        },
        {
          "description": "Live: the state the observer holds now is this one.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "holds",
            "state"
          ],
          "properties": {
            "holds": {
              "$ref": "#/definitions/name"
            },
            "state": {}
          }
        },
        {
          "description": "Live: the observer's live query completes.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completes"
          ],
          "properties": {
            "completes": {
              "$ref": "#/definitions/name"
            }
          }
        },
        {
          "description": "Live: the next request the client makes of a service is on this channel; `as` names its correlation id, for the backend to answer.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fetch",
            "as"
          ],
          "properties": {
            "fetch": {
              "type": "string"
            },
            "payload": {},
            "as": {
              "$ref": "#/definitions/name"
            }
          }
        },
        {
          "description": "Live: the next requests the client makes of a service are these, in whatever order it makes them.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fetches"
          ],
          "properties": {
            "fetches": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fetch",
                  "as"
                ],
                "properties": {
                  "fetch": {
                    "type": "string"
                  },
                  "payload": {},
                  "as": {
                    "$ref": "#/definitions/name"
                  }
                }
              }
            }
          }
        },
        {
          "description": "Live: the client's stream comes to name exactly these scopes.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scopes"
          ],
          "properties": {
            "scopes": {
              "type": "array"
            }
          }
        }
      ]
    }
  }
}
