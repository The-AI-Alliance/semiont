{
  "name": "@semiont/tests-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end smoke tests. Runs against a locally-running gateway and frontend; see README.md.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck",
    "test": "playwright test --grep-invert @slow",
    "pretest:slow": "npm run typecheck",
    "test:slow": "playwright test --grep @slow",
    "pretest:ci": "npm run typecheck",
    "test:ci": "playwright test --grep-invert \"@slow|@model\"",
    "pretest:model": "npm run typecheck",
    "test:model": "playwright test --grep @model",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "show-report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@semiont/core": "file:../../packages/typescript/core",
    "@semiont/sdk": "file:../../packages/typescript/sdk",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.2"
  }
}
