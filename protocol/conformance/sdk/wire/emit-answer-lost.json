    {"wire": "POST /bus/emit", "status": 202, "headers": {"Idempotency-Key": {"$var": "key"}}, "body": {"channel": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "correlationId": {"$var": "cid"}, "clientId": {"$var": "clientId"}}, "answer": {"$var": "accepted"}},
    {"backend": "emit", "with": {"channel": "browse:resource-result", "correlationId": {"$var": "cid"}, "payload": {"response": {"$var": "response"}}}},
