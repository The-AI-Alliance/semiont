    {"wire": "POST /bus/emit", "status": 202, "headers": {"Idempotency-Key": {"$fresh": "key"}}, "body": {"channel": "browse:resource-requested", "payload": {"resourceId": {"$var": "r1"}}, "correlationId": {"$var": "cid"}, "clientId": {"$var": "clientId"}}, "answer": {"$var": "accepted"}, "as": "lost"},
