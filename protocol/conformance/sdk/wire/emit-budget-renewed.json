{
  "about": "an emit sent again with a renewed credential has an emitRetry budget of its own: the attempts made before the renewal are not counted against it, so an emit refused 503 on every attempt but the one refused 401 is sent as many times as two budgets allow, and fails as unavailable once the second is spent",
  "source": "protocol/contract/TRANSPORT-HTTP.md § Emitting; protocol/contract/TRANSPORT-CONTRACT.md § Emits; protocol/specs/src/client/timing.json emitRetry",
  "steps": [
    {"driver": "open", "with": {"channels": ["beckon:focus"], "timing": {"reconnectMs": 50, "lazyRemoveMs": 50, "emitRetry": {"attempts": 4, "initialDelayMs": 10, "maxDelayMs": 10}}, "renewals": [{"$var": "token2"}, "never-asked"]}},
    {"wire": "POST /bus/subscribe", "status": 200, "token": {"$var": "token"}, "body": {"clientId": {"$var": "clientId"}, "global": ["beckon:focus"], "scoped": [], "pendingReplies": []}},
    {"state": "open"},
    {"backend": "refuse", "with": {"wire": "POST /bus/emit", "status": 503, "body": {"error": "The signal plane's broker is not connected"}, "times": 3}},
    {"backend": "refuse", "with": {"wire": "POST /bus/emit", "status": 401, "headers": {"WWW-Authenticate": "Bearer error=\"invalid_token\", resource_metadata=\"http://gateway.test/.well-known/oauth-protected-resource\""}, "body": {"error": "Invalid token"}, "times": 1}},
    {"backend": "refuse", "with": {"wire": "POST /bus/emit", "status": 503, "body": {"error": "The signal plane's broker is not connected"}, "times": 4}},

    {"driver": "emit", "with": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}}, "as": "emitted"},
    {"wire": "POST /bus/emit", "status": 503, "token": {"$var": "token"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"wire": "POST /bus/emit", "status": 503, "token": {"$var": "token"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"wire": "POST /bus/emit", "status": 503, "token": {"$var": "token"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"wire": "POST /bus/emit", "status": 401, "token": {"$var": "token"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"wire": "POST /bus/emit", "status": 503, "token": {"$var": "token2"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"wire": "POST /bus/emit", "status": 503, "token": {"$var": "token2"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"wire": "POST /bus/emit", "status": 503, "token": {"$var": "token2"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"wire": "POST /bus/emit", "status": 503, "token": {"$var": "token2"}, "body": {"channel": "beckon:focus", "payload": {"resourceId": "res-1"}, "clientId": {"$var": "clientId"}}},
    {"settles": "emitted", "fails": {"code": "unavailable", "status": 503}},
    {"error": {"code": "unavailable", "status": 503}},
    {"quiet": 300}
  ]
}
