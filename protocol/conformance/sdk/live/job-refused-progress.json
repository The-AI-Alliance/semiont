{
  "about": "a frame of a job's lifecycle that the follower's reading refuses is reported, once the job has its id, as a refusal naming the channel, the member and the reason, and the follower goes on following: a later completion ends it",
  "source": "protocol/contract/JOBS.md § Following a job; protocol/specs/src/bus/frame-cases.json",
  "tier": "parity",
  "notYetReached": {
    "swift": "The Swift SDK's stream reader, which is to hold each frame to BusFrame.",
    "csharp": "The C# SDK's stream reader, which is to hold each frame to BusFrame."
  },
  "steps": [
    {"backend": "listen", "with": {"channels": ["job:create"]}},
    {"driver": "open", "with": {"timing": {"busRequestTimeoutMs": 5000, "invalidationWindowMs": 100, "reconnectMs": 50, "lazyRemoveMs": 50, "lingerMs": 50, "jobSilenceMs": 60000, "jobStatusPollMs": 60000}}},
    {"state": "open"},

    {"driver": "markDelegate", "with": {"observer": "job", "resource": {"$var": "r1"}, "params": {"motivation": "highlighting"}}},
    {"fetch": "job:create", "payload": {"jobType": "mark", "resourceId": {"$var": "r1"}, "params": {"motivation": "highlighting"}}, "as": "c1"},
    {"backend": "emit", "with": {"channel": "job:created", "correlationId": {"$var": "c1"}, "payload": {"response": {"jobId": "job-1"}}}},
    {"reaches": "job", "state": {"status": "ready", "value": {"kind": "created", "data": {"jobId": "job-1"}}}},

    {"backend": "carry", "with": {"frame": {"channel": "job:report-progress", "payload": {"resourceId": {"$var": "r1"}, "jobType": "mark", "percentage": 10, "progress": {"percentage": 10}}}}},
    {"reaches": "job", "state": {"status": "ready", "value": {"kind": "refused", "data": {"channel": "job:report-progress", "member": "payload.jobId", "reason": "lacks"}}}},

    {"backend": "emit", "with": {"channel": "job:complete", "payload": {"resourceId": {"$var": "r1"}, "jobId": "job-1", "jobType": "mark"}}},
    {"reaches": "job", "state": {"status": "ready", "value": {"kind": "complete", "data": {"_userId": {"$var": "_"}, "resourceId": {"$var": "r1"}, "jobId": "job-1", "jobType": "mark"}}}},
    {"completes": "job"},
    {"quiet": 300}
  ]
}
