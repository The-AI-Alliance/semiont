    {"backend": "record", "with": {"resource": {"$var": "r1"}, "channel": "mark:body-updated", "sequence": 1, "live": true, "payload": {"annotationId": {"$var": "a1"}, "operations": []}, "enriched": {"annotation": {"@context": "http://www.w3.org/ns/anno.jsonld", "type": "Annotation", "id": {"$var": "a1"}, "motivation": "commenting", "target": {"source": {"$var": "r1"}}, "created": "2026-01-01T00:00:00.000Z"}}}},
    {"reaches": "a", "state": {"status": "ready", "value": {"@context": "http://www.w3.org/ns/anno.jsonld", "type": "Annotation", "id": {"$var": "a1"}, "motivation": "commenting", "target": {"source": {"$var": "r1"}}, "created": "2026-01-01T00:00:00.000Z"}}},
    {"backend": "emit", "with": {"channel": "browse:annotation-result", "correlationId": {"$var": "d1"}, "payload": {"response": {"annotation": {"@context": "http://www.w3.org/ns/anno.jsonld", "type": "Annotation", "id": {"$var": "a1"}, "motivation": "highlighting", "target": {"source": {"$var": "r1"}}, "created": "2026-01-01T00:00:00.000Z"}, "resource": null, "resolvedResource": null}}}},
    {"quiet": 300},
    {"holds": "a", "state": {"status": "ready", "value": {"@context": "http://www.w3.org/ns/anno.jsonld", "type": "Annotation", "id": {"$var": "a1"}, "motivation": "commenting", "target": {"source": {"$var": "r1"}}, "created": "2026-01-01T00:00:00.000Z"}}}
  ]
