{
  "type": "object",
  "description": "Payload for job:started domain event",
  "properties": {
    "jobId": { "$ref": "./JobId.json" },
    "jobType": { "$ref": "JobType.json" },
    "annotationId": { "allOf": [{ "$ref": "./AnnotationId.json" }], "description": "Annotation this job is attached to, when applicable" },
    "totalSteps": { "type": "integer" }
  },
  "required": ["jobId", "jobType"]
}
