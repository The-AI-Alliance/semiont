{
  "get": {
    "operationId": "getResourceAnnotations",
    "summary": "A resource's annotations",
    "description": "Every annotation on the resource, with the people it mentions named, and how many there are: what the gateway serves at its own `GET /resources/{id}/annotations`, and what a service reads directly. Never the bus's: a resource's annotations grow without a bound.",
    "security": [
      {
        "serviceAccount": []
      }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The resource, percent-encoded.",
        "schema": {
          "$ref": "../../components/schemas/ResourceId.json"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "The annotations.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/GetAnnotationsResponse.json"
            }
          }
        }
      },
      "401": {
        "$ref": "../responses/Unauthorized.json"
      },
      "404": {
        "description": "The record holds no such resource.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/ErrorResponse.json"
            }
          }
        }
      },
      "500": {
        "$ref": "../../components/responses/InternalError.json"
      }
    }
  }
}
