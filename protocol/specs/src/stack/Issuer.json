{
  "title": "Issuer",
  "type": "object",
  "description": "The issuer the launcher runs for the knowledge bases on a machine, with a realm for each, and the database it keeps their realms in. It belongs to no knowledge base, so its document is kept in the launcher's state home, in `stack/issuer.yaml`, not in a knowledge base's repository. A knowledge base trusts it by naming `shared`; one trusting somebody else's issuer names it at `external`.",
  "properties": {
    "apiVersion": {
      "$ref": "./ApiVersion.json"
    },
    "kind": {
      "type": "string",
      "const": "Issuer"
    },
    "metadata": {
      "$ref": "./Metadata.json"
    },
    "spec": {
      "type": "object",
      "description": "The issuer, where it is published, and the database it keeps its realms in.",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "The issuer's driver: `keycloak`."
        },
        "image": {
          "$ref": "./Image.json"
        },
        "resources": {
          "$ref": "./Resources.json"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "The port the issuer is published on, on this machine: the origin of every realm's `iss`, so the one number wherever the issuer is reached."
        },
        "database": {
          "type": "object",
          "description": "The database the issuer keeps its realms in.",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1,
              "description": "The database's driver: `postgres`."
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,62}$",
              "description": "The database the issuer keeps its realms in: a lowercase PostgreSQL identifier, as PostgreSQL itself names an unquoted one. On a PostgreSQL the launcher runs, the launcher creates it; on one somebody else runs (`external`), it must already exist there."
            },
            "user": {
              "type": "string",
              "minLength": 1,
              "description": "The user the issuer signs in as."
            },
            "image": {
              "$ref": "./Image.json"
            },
            "resources": {
              "$ref": "./Resources.json"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "The port a PostgreSQL the launcher runs is published on, on this machine, where the issuer reaches it. One somebody else runs is reached at `external`."
            },
            "external": {
              "type": "object",
              "description": "A database somebody else runs.",
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A host name or address the issuer can reach."
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535,
                  "description": "The port it listens on."
                },
                "password": {
                  "$ref": "./SecretRef.json"
                }
              },
              "required": [
                "host",
                "port",
                "password"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "name",
            "user"
          ],
          "allOf": [
            {
              "$ref": "./Runner.json"
            },
            {
              "oneOf": [
                {
                  "required": [
                    "port"
                  ],
                  "not": {
                    "required": [
                      "external"
                    ]
                  }
                },
                {
                  "required": [
                    "external"
                  ],
                  "not": {
                    "required": [
                      "port"
                    ]
                  }
                }
              ]
            }
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "image",
        "resources",
        "port",
        "database"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
